#!/bin/sh
# Commit gate: a commit with staged source changes under app/ must pass the
# per-commit gate (`make -C app precommit`: lint + the ungated suite, one
# container). Changes limited to app/docs/ or app/README.md do not run it.
# `make check` (lint, asset build, coverage-gated suite) runs once per branch
# before a PR opens; CI runs it again on push/PR as the backstop.
set -eu
root=$(git rev-parse --show-toplevel)
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if printf '%s\n' "$staged" | grep -Eq "^app/" \
   && printf '%s\n' "$staged" | grep -E "^app/" | grep -Evq "^app/docs/|^app/README\.md$"; then
  echo "pre-commit: make -C app precommit"
  make -C "$root/app" precommit
fi
