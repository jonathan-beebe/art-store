# Mirrors and extends src/.gitignore: keep the build context small and keep
# host-only state (the bundle, logs, databases, uploads, env files) out of
# every image — the build stage installs and builds its own copies, and the
# Dockerfile recreates the writable directories.
src/.bundle/
src/vendor/bundle/
src/.env*
src/log/
src/tmp/
src/storage/
src/coverage/
src/public/assets/
src/app/assets/builds/
src/config/*.key

docs/
work/
__local__/
.git/
