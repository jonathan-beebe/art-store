<% if flash[:debug_magic_link].present? %>
  <div role="alert" data-debug-alert class="border-b border-yellow-400 dark:border-yellow-900 bg-yellow-100 dark:bg-yellow-950 px-6 py-3 text-sm text-yellow-900 dark:text-yellow-200">
    <span class="font-semibold">Debug</span> &mdash; the prototype has no mailbox, so the magic link lands here:
    <%= link_to flash[:debug_magic_link], flash[:debug_magic_link], class: "break-all underline" %>
  </div>
<% end %>
