<% if flash[:notice].present? %>
  <div role="status" data-flash="notice" class="border-b border-emerald-300 dark:border-emerald-900 bg-emerald-50 dark:bg-emerald-950/40 px-6 py-3 text-sm text-emerald-900 dark:text-emerald-200">
    <%= flash[:notice] %>
  </div>
<% end %>

<% if flash[:alert].present? %>
  <div role="alert" data-flash="alert" class="border-b border-red-300 dark:border-red-900 bg-red-50 dark:bg-red-950/40 px-6 py-3 text-sm text-red-900 dark:text-red-200">
    <%= flash[:alert] %>
  </div>
<% end %>
