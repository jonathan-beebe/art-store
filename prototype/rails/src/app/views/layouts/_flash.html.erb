<% if flash[:notice].present? %>
  <div role="status" data-flash="notice" class="border-b border-emerald-300 bg-emerald-50 px-6 py-3 text-sm text-emerald-900">
    <%= flash[:notice] %>
  </div>
<% end %>

<% if flash[:alert].present? %>
  <div role="alert" data-flash="alert" class="border-b border-red-300 bg-red-50 px-6 py-3 text-sm text-red-900">
    <%= flash[:alert] %>
  </div>
<% end %>
