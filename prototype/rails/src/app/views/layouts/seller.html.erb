<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Seller portal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app %>
  </head>

  <body data-site="seller" class="min-h-screen bg-neutral-100 text-sm text-neutral-900">
    <%= render "layouts/debug_alert" %>

    <header class="bg-neutral-900 text-neutral-100">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-2">
        <%= link_to "Seller portal", seller_root_path, class: "font-semibold" %>
        <nav class="flex gap-4 text-neutral-300">
          <%= link_to "Dashboard", seller_root_path %>
          <%= link_to "Storefront", root_path %>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-6">
      <%= yield %>
    </main>
  </body>
</html>
