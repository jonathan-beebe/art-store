<% content_for :title, "Seller portal" %>

<h1 class="text-lg font-semibold">Dashboard</h1>
<p class="mt-1 text-neutral-500">Listings, orders to ship, and earnings land here.</p>

<div class="mt-4 grid gap-px overflow-hidden rounded border border-neutral-300 bg-neutral-300 sm:grid-cols-3">
  <% [ "Listings", "To ship", "Available" ].each do |label| %>
    <div class="bg-white px-4 py-3">
      <div class="text-xs uppercase tracking-wide text-neutral-500"><%= label %></div>
      <div class="mt-1 text-2xl tabular-nums text-neutral-400">&mdash;</div>
    </div>
  <% end %>
</div>
