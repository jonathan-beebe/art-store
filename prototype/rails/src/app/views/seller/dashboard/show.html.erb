<% content_for :title, "Dashboard — Art Store seller" %>

<h1 class="text-lg font-semibold">Dashboard</h1>

<section aria-labelledby="listings-heading" class="mt-6">
  <div class="flex flex-wrap items-center gap-4">
    <h2 id="listings-heading" class="font-semibold text-neutral-700 dark:text-neutral-300">Listings</h2>
    <%= link_to "All listings", seller_listings_path, class: "ml-auto underline" %>
  </div>

  <dl class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <% @listing_status_counts.each do |status, count| %>
      <%= render "seller/shared/stat", key: status, label: status_label(status), value: count %>
    <% end %>
  </dl>
</section>

<section aria-labelledby="work-heading" class="mt-6">
  <h2 id="work-heading" class="font-semibold text-neutral-700 dark:text-neutral-300">Money and work</h2>

  <dl class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <%= render "seller/shared/stat", key: "awaiting_shipment", label: "Awaiting shipment", value: @awaiting_shipment %>
    <%= render "seller/shared/stat", key: "held", label: "Held in escrow", value: @balance.held.format %>
    <%= render "seller/shared/stat", key: "available", label: "Available", value: @balance.available.format %>
    <%= render "seller/shared/stat", key: "unread_notifications", label: "Unread notifications", value: @unread_notifications %>
  </dl>
</section>

<section aria-labelledby="support-heading" class="mt-6">
  <h2 id="support-heading" class="font-semibold text-neutral-700 dark:text-neutral-300">Support</h2>

  <div class="mt-2 flex flex-wrap items-center gap-4 rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 p-4">
    <p class="text-neutral-600 dark:text-neutral-400">Reach the Art Store team about your shop, a payout, or an order.</p>
    <%= button_to "Support", seller_support_path, form_class: "ml-auto",
          class: "rounded bg-neutral-900 dark:bg-neutral-100 px-4 py-2 font-medium text-white dark:text-neutral-900" %>
  </div>
</section>

<section aria-labelledby="notifications-heading" class="mt-6">
  <div class="flex flex-wrap items-center gap-4">
    <h2 id="notifications-heading" class="font-semibold text-neutral-700 dark:text-neutral-300">Recent notifications</h2>
    <%= link_to "All notifications", seller_notifications_path, class: "ml-auto underline" %>
  </div>

  <% if @recent_notifications.empty? %>
    <p class="mt-2 rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 p-4 text-neutral-600 dark:text-neutral-400">Nothing yet.</p>
  <% else %>
    <ul class="mt-2 divide-y divide-neutral-200 dark:divide-neutral-800 rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900">
      <% @recent_notifications.each do |notification| %>
        <li data-recent-notification class="p-4">
          <p class="font-medium"><%= notification.subject %></p>
          <p class="mt-1 text-neutral-600 dark:text-neutral-400"><%= notification.body %></p>
          <p class="mt-1 text-neutral-500"><%= notification.created_at.strftime("%b %-d, %Y %-l:%M%P") %></p>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
