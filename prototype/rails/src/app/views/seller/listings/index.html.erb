<% content_for :title, "Listings — Art Store seller" %>

<div class="flex flex-wrap items-center gap-4">
  <h1 class="text-lg font-semibold">Listings</h1>
  <%= link_to "New listing", new_seller_listing_path, class: "ml-auto rounded bg-neutral-900 px-4 py-2 font-medium text-white" %>
</div>

<% if @listings.empty? %>
  <p class="mt-4 rounded border border-neutral-300 bg-white p-4 text-neutral-600">No listings yet. Start with a new one.</p>
<% else %>
  <div class="mt-4 overflow-x-auto rounded border border-neutral-300 bg-white">
    <table class="w-full text-left">
      <caption class="sr-only">Your listings, newest first</caption>
      <thead class="border-b border-neutral-300 bg-neutral-50">
        <tr>
          <th scope="col" class="px-4 py-2 font-semibold">Listing</th>
          <th scope="col" class="px-4 py-2 font-semibold">Status</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Price</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Qty</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Views</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Favorites</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Cart adds</th>
          <th scope="col" class="px-4 py-2 font-semibold">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-200">
        <% @listings.each do |listing| %>
          <tr data-listing="<%= listing.id %>">
            <th scope="row" class="px-4 py-3 font-normal">
              <span class="flex items-center gap-3">
                <img src="<%= listing.image_url %>" alt="" width="48" height="48" class="h-12 w-12 rounded object-cover">
                <%= link_to listing.title, seller_listing_path(listing), class: "font-medium underline" %>
              </span>
            </th>
            <td data-cell="status" class="px-4 py-3"><%= status_label(listing.status) %></td>
            <td class="px-4 py-3 text-right tabular-nums"><%= listing.price.format %></td>
            <td class="px-4 py-3 text-right tabular-nums"><%= listing.quantity %></td>
            <td data-activity="views" class="px-4 py-3 text-right tabular-nums"><%= @activity[listing].views %></td>
            <td data-activity="favorites" class="px-4 py-3 text-right tabular-nums"><%= @activity[listing].favorites %></td>
            <td data-activity="cart_adds" class="px-4 py-3 text-right tabular-nums"><%= @activity[listing].cart_adds %></td>
            <td class="px-4 py-3">
              <span class="flex flex-wrap items-center gap-2">
                <%= link_to "Edit", edit_seller_listing_path(listing), class: "rounded border border-neutral-400 px-2 py-1" %>
                <%= render "seller/listings/status_buttons", listing: listing %>
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
