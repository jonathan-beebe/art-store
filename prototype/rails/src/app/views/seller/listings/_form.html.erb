<%= form_with url: url, method: method, scope: :listing, html: { multipart: true, class: "mt-4 max-w-3xl rounded border border-neutral-300 bg-white p-4" } do |form| %>
  <fieldset>
    <legend class="font-semibold text-neutral-700">Listing details</legend>

    <div class="mt-2">
      <%= form.label :title, "Title", class: "block font-medium text-neutral-700" %>
      <%= form.text_field :title, value: fields[:title], required: true, maxlength: 255,
            "aria-describedby": errors[:title] && "listing_title-error",
            class: "mt-1 block w-full rounded border border-neutral-400 px-3 py-2" %>
      <%= render "seller/shared/field_error", field: "listing_title", message: errors[:title] %>
    </div>

    <div class="mt-4">
      <%= form.label :description, "Description", class: "block font-medium text-neutral-700" %>
      <%= form.text_area :description, value: fields[:description], rows: 4, maxlength: 5000,
            "aria-describedby": errors[:description] && "listing_description-error",
            class: "mt-1 block w-full rounded border border-neutral-400 px-3 py-2" %>
      <%= render "seller/shared/field_error", field: "listing_description", message: errors[:description] %>
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :medium, "Medium", class: "block font-medium text-neutral-700" %>
        <%= form.text_field :medium, value: fields[:medium], maxlength: 255,
              "aria-describedby": errors[:medium] && "listing_medium-error",
              class: "mt-1 block w-full rounded border border-neutral-400 px-3 py-2" %>
        <%= render "seller/shared/field_error", field: "listing_medium", message: errors[:medium] %>
      </div>

      <div>
        <%= form.label :dimensions, "Dimensions", class: "block font-medium text-neutral-700" %>
        <%= form.text_field :dimensions, value: fields[:dimensions], maxlength: 255,
              "aria-describedby": errors[:dimensions] && "listing_dimensions-error",
              class: "mt-1 block w-full rounded border border-neutral-400 px-3 py-2" %>
        <%= render "seller/shared/field_error", field: "listing_dimensions", message: errors[:dimensions] %>
      </div>

      <div>
        <%= form.label :price, "Price (dollars)", class: "block font-medium text-neutral-700" %>
        <%= form.number_field :price, value: fields[:price], step: "0.01", min: "0", required: true,
              "aria-describedby": errors[:price] && "listing_price-error",
              class: "mt-1 block w-full rounded border border-neutral-400 px-3 py-2" %>
        <%= render "seller/shared/field_error", field: "listing_price", message: errors[:price] %>
      </div>

      <div>
        <%= form.label :quantity, "Quantity", class: "block font-medium text-neutral-700" %>
        <%= form.number_field :quantity, value: fields[:quantity], step: 1, min: 0, max: 999, required: true,
              "aria-describedby": errors[:quantity] && "listing_quantity-error",
              class: "mt-1 block w-full rounded border border-neutral-400 px-3 py-2" %>
        <%= render "seller/shared/field_error", field: "listing_quantity", message: errors[:quantity] %>
      </div>
    </div>

    <div class="mt-4">
      <%= form.label :image, "Image", class: "block font-medium text-neutral-700" %>
      <%= form.file_field :image, accept: "image/*",
            "aria-describedby": "listing_image-hint#{" listing_image-error" if errors[:image]}",
            class: "mt-1 block w-full rounded border border-neutral-400 px-3 py-2" %>
      <p id="listing_image-hint" class="mt-1 text-neutral-600">
        An image file up to a few megabytes. Artwork drawn from the title stands in until you upload one.
      </p>
      <%= render "seller/shared/field_error", field: "listing_image", message: errors[:image] %>
    </div>
  </fieldset>

  <div class="mt-6 flex items-center gap-3">
    <%= form.submit submit_label, class: "rounded bg-neutral-900 px-4 py-2 font-medium text-white" %>
    <%= link_to "Cancel", seller_listings_path, class: "underline" %>
  </div>
<% end %>
