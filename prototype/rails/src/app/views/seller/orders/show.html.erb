<% content_for :title, "Order ##{@fulfillment.order_id} — Art Store seller" %>

<div class="flex flex-wrap items-center gap-4">
  <h1 class="text-lg font-semibold">Order #<%= @fulfillment.order_id %></h1>
  <p data-cell="status" class="text-neutral-600"><%= status_label(@fulfillment.status) %></p>
  <%= link_to "All orders", seller_orders_path, class: "ml-auto underline" %>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <section aria-labelledby="address-heading">
    <h2 id="address-heading" class="font-semibold text-neutral-700">Ship to</h2>

    <address data-shipping-address class="mt-2 rounded border border-neutral-300 bg-white p-4 not-italic">
      <%= @fulfillment.order.shipping_name %><br>
      <%= @fulfillment.order.shipping_line1 %><br>
      <% if @fulfillment.order.shipping_line2.present? %>
        <%= @fulfillment.order.shipping_line2 %><br>
      <% end %>
      <%= @fulfillment.order.shipping_city %>, <%= @fulfillment.order.shipping_region %><br>
      <%= @fulfillment.order.shipping_postal_code %><br>
      <%= @fulfillment.order.shipping_country %>
    </address>
  </section>

  <section aria-labelledby="items-heading">
    <h2 id="items-heading" class="font-semibold text-neutral-700">Your items</h2>

    <div class="mt-2 overflow-x-auto rounded border border-neutral-300 bg-white">
      <table class="w-full text-left">
        <caption class="sr-only">Items in this order that belong to you</caption>
        <thead class="border-b border-neutral-300 bg-neutral-50">
          <tr>
            <th scope="col" class="px-4 py-2 font-semibold">Item</th>
            <th scope="col" class="px-4 py-2 text-right font-semibold">Qty</th>
            <th scope="col" class="px-4 py-2 text-right font-semibold">Unit price</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-200">
          <% own_items(@fulfillment.order).each do |item| %>
            <tr data-item="<%= item.id %>">
              <th scope="row" class="px-4 py-2 font-normal"><%= item.title %></th>
              <td class="px-4 py-2 text-right tabular-nums"><%= item.quantity %></td>
              <td class="px-4 py-2 text-right tabular-nums"><%= Money.from_cents(item.unit_price_cents).format %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot class="border-t border-neutral-300">
          <tr>
            <th scope="row" class="px-4 py-2 text-left font-semibold">Net to you</th>
            <td colspan="2" data-cell="net" class="px-4 py-2 text-right font-semibold tabular-nums"><%= @fulfillment.net.format %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </section>
</div>

<section aria-labelledby="shipment-heading" class="mt-6 max-w-xl">
  <h2 id="shipment-heading" class="font-semibold text-neutral-700">Shipment</h2>

  <% if @fulfillment.can_transition_to?(:shipped) %>
    <%= form_with url: seller_order_shipment_path(@fulfillment), method: :post,
          html: { class: "mt-2 rounded border border-neutral-300 bg-white p-4" } do |form| %>
      <fieldset>
        <legend class="font-medium text-neutral-700">Mark shipped</legend>

        <div class="mt-2">
          <%= form.label :carrier, "Carrier", class: "block font-medium text-neutral-700" %>
          <%= form.text_field :carrier, required: true, maxlength: 255,
                class: "mt-1 block w-full rounded border border-neutral-400 px-3 py-2" %>
        </div>

        <div class="mt-4">
          <%= form.label :tracking_number, "Tracking number", class: "block font-medium text-neutral-700" %>
          <%= form.text_field :tracking_number, required: true, maxlength: 255,
                class: "mt-1 block w-full rounded border border-neutral-400 px-3 py-2" %>
        </div>
      </fieldset>

      <%= form.submit "Mark shipped", class: "mt-4 rounded bg-neutral-900 px-4 py-2 font-medium text-white" %>
    <% end %>
  <% else %>
    <dl data-shipment class="mt-2 rounded border border-neutral-300 bg-white p-4">
      <dt class="text-neutral-600">Carrier</dt>
      <dd data-cell="carrier" class="mt-1"><%= @fulfillment.carrier %></dd>
      <dt class="mt-3 text-neutral-600">Tracking number</dt>
      <dd data-cell="tracking_number" class="mt-1"><%= @fulfillment.tracking_number %></dd>
      <dt class="mt-3 text-neutral-600">Shipped</dt>
      <dd data-cell="shipped_at" class="mt-1"><%= @fulfillment.shipped_at.strftime("%b %-d, %Y %-l:%M%P") %></dd>
      <% if @fulfillment.delivered_at %>
        <dt class="mt-3 text-neutral-600">Delivered</dt>
        <dd data-cell="delivered_at" class="mt-1"><%= @fulfillment.delivered_at.strftime("%b %-d, %Y %-l:%M%P") %></dd>
      <% end %>
    </dl>
  <% end %>
</section>
