<li data-message="<%= message.id %>" class="rounded border border-neutral-300 bg-white p-4">
  <p class="text-neutral-500">
    <%= message.sender.display_name %> &middot;
    <%= message.created_at.strftime("%b %-d, %Y %-l:%M%P") %>
  </p>
  <p class="mt-1 whitespace-pre-line"><%= message.body %></p>
</li>
