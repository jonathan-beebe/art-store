<li data-message="<%= message.id %>" class="rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 p-4">
  <p class="text-neutral-500">
    <%= message.sender.display_name %> &middot;
    <%= message.created_at.strftime("%b %-d, %Y %-l:%M%P") %>
  </p>
  <p class="mt-1 whitespace-pre-line"><%= message.body %></p>
  <% if message.listing_faq %>
    <p data-faq-published class="mt-1 text-emerald-700 dark:text-emerald-400">Published as an FAQ on the listing.</p>
  <% end %>
</li>
