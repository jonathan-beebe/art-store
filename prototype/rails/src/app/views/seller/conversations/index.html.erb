<% content_for :title, "Messages — Art Store seller" %>

<h1 class="text-lg font-semibold">Messages</h1>

<% if @conversations.empty? %>
  <p class="mt-4 rounded border border-neutral-300 bg-white p-4 text-neutral-600">Nothing yet.</p>
<% else %>
  <ul class="mt-4 divide-y divide-neutral-200 rounded border border-neutral-300 bg-white">
    <% @conversations.each do |conversation| %>
      <% unread = @unread_counts[conversation.id] %>
      <li data-conversation="<%= conversation.id %>" class="flex flex-wrap items-baseline gap-x-4 gap-y-1 p-4">
        <p class="font-medium">
          <%= link_to conversation.counterpart_of(current_seller).display_name,
                seller_conversation_path(conversation), class: "underline" %>
        </p>
        <p data-cell="topic" class="text-neutral-600"><%= conversation.topic %></p>
        <span data-unread-count="<%= unread %>"
              class="rounded px-2 py-0.5 text-xs <%= unread.positive? ? "bg-neutral-900 text-white" : "bg-neutral-200 text-neutral-600" %>">
          <%= unread.positive? ? "#{unread} unread" : "Read" %>
        </span>
        <p class="ml-auto text-neutral-500"><%= conversation.last_message_at.strftime("%b %-d, %Y %-l:%M%P") %></p>
      </li>
    <% end %>
  </ul>
<% end %>
