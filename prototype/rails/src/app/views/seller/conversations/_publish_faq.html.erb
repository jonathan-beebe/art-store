<% if draft %>
  <section aria-labelledby="publish-faq-heading"
      class="mt-6 max-w-2xl rounded border border-neutral-300 bg-white p-4">
    <h2 id="publish-faq-heading" class="font-semibold text-neutral-700">Publish as FAQ</h2>
    <% if draft.errors[:source_message_id].present? %>
      <p role="alert" data-faq-refusal class="mt-1 rounded border border-red-300 bg-red-50 p-3 text-red-900">
        <%= draft.errors[:source_message_id].first %>
      </p>
    <% else %>
      <p class="mt-1 text-neutral-600">The pair goes on the listing page for every visitor.</p>
    <% end %>

    <%= form_with model: draft, url: seller_listing_faqs_path(draft.listing), namespace: "publish_faq",
          html: { class: "mt-3" } do |form| %>
      <%= render "seller/faqs/fields", form: form %>
      <%= form.submit "Publish as FAQ", class: "mt-4 rounded bg-neutral-900 px-4 py-2 font-medium text-white" %>
    <% end %>
  </section>
<% end %>
