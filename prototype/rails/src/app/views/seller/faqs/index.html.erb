<% content_for :title, "FAQs — #{@listing.title} — Art Store seller" %>

<div class="flex flex-wrap items-center gap-4">
  <h1 class="text-lg font-semibold">FAQs for “<%= @listing.title %>”</h1>
  <%= link_to "Back to listing", seller_listing_path(@listing), class: "ml-auto underline" %>
</div>

<p class="mt-2 text-neutral-600">Every entry here shows on the storefront listing page.</p>

<% if @faqs.empty? %>
  <p class="mt-4 rounded border border-neutral-300 bg-white p-4 text-neutral-600">Nothing published yet.</p>
<% else %>
  <ol class="mt-4 max-w-2xl space-y-4">
    <% @faqs.each do |faq| %>
      <li data-faq="<%= faq.id %>" class="rounded border border-neutral-300 bg-white p-4">
        <%= form_with model: faq, url: seller_listing_faq_path(@listing, faq), method: :patch,
              namespace: "faq_#{faq.id}" do |form| %>
          <%= render "seller/faqs/fields", form: form %>
          <%= form.submit "Save", class: "mt-4 rounded bg-neutral-900 px-4 py-2 font-medium text-white" %>
        <% end %>

        <%= button_to "Unpublish", seller_listing_faq_path(@listing, faq), method: :delete,
              class: "mt-3 rounded border border-neutral-400 px-3 py-2" %>
      </li>
    <% end %>
  </ol>
<% end %>

<section aria-labelledby="publish-heading" class="mt-6 max-w-2xl">
  <h2 id="publish-heading" class="font-semibold text-neutral-700">Publish an entry</h2>

  <%= form_with model: @faq, url: seller_listing_faqs_path(@listing),
        html: { class: "mt-2 rounded border border-neutral-300 bg-white p-4" } do |form| %>
    <%= render "seller/faqs/fields", form: form %>
    <%= form.submit "Publish", class: "mt-4 rounded bg-neutral-900 px-4 py-2 font-medium text-white" %>
  <% end %>
</section>
