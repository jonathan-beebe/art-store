<% content_for :title, "#{@listing.title} — Art Store" %>

<article class="grid gap-12 lg:grid-cols-2">
  <%= image_tag @listing.image_url, alt: @listing.title, class: "aspect-square w-full rounded-3xl object-cover" %>

  <div class="max-w-lg">
    <h1 class="text-4xl font-light leading-tight tracking-tight"><%= @listing.title %></h1>
    <p class="mt-3 text-lg text-neutral-500"><%= @listing.seller.display_name %></p>
    <p class="mt-8 text-2xl"><%= money(@listing.price_cents) %></p>

    <dl class="mt-8 grid grid-cols-2 gap-y-4 border-y border-neutral-100 py-6 text-base">
      <dt class="text-neutral-500">Medium</dt>
      <dd><%= @listing.medium.presence || "Mixed" %></dd>
      <dt class="text-neutral-500">Dimensions</dt>
      <dd><%= @listing.dimensions.presence || "Unlisted" %></dd>
      <dt class="text-neutral-500">Available</dt>
      <dd data-availability><%= @purchasable ? @listing.quantity : "Sold" %></dd>
    </dl>

    <p class="mt-8 text-lg leading-relaxed text-neutral-700"><%= @listing.description %></p>

    <div class="mt-10 flex flex-wrap items-end gap-4">
      <% if @purchasable %>
        <%= form_with url: shop_add_to_cart_path(slug: @listing.slug), method: :post, class: "flex items-end gap-4" do |form| %>
          <% if @listing.quantity > 1 %>
            <div>
              <%= form.label :quantity, "Quantity", class: "block text-xs uppercase tracking-wide text-neutral-500" %>
              <%= form.number_field :quantity, value: 1, min: 1, max: @listing.quantity,
                    class: "mt-2 w-24 rounded-lg border border-neutral-300 px-4 py-3 text-lg" %>
            </div>
          <% end %>
          <%= form.submit "Add to cart", class: "rounded-full bg-neutral-900 px-8 py-3 text-base text-white" %>
        <% end %>
      <% end %>

      <%= button_to @favorited ? "Remove from favorites" : "Favorite",
            shop_toggle_favorite_path(slug: @listing.slug),
            method: :post,
            class: "rounded-full border border-neutral-300 px-8 py-3 text-base hover:border-neutral-900" %>
    </div>
  </div>
</article>
