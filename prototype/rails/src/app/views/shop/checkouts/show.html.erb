<% content_for :title, "Checkout — Art Store" %>

<h1 class="text-4xl font-light tracking-tight">Checkout</h1>

<div class="mt-12 grid gap-16 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
  <%= form_with url: shop_place_order_path, method: :post, class: "max-w-xl" do |form| %>
    <h2 class="text-xs uppercase tracking-wide text-neutral-500">Contact</h2>

    <div class="mt-4">
      <%= form.label :email, "Email address", class: "block text-base" %>
      <%= form.email_field :email, value: @form.email, required: true, autocomplete: "email",
            readonly: customer_signed_in?,
            class: "mt-2 block w-full rounded-lg border border-neutral-300 px-4 py-3 text-lg read-only:bg-neutral-50" %>
    </div>

    <% unless customer_signed_in? %>
      <p class="mt-3 text-base text-neutral-500">
        We email a link to this address. Opening it verifies you and takes you straight to payment.
      </p>
    <% end %>

    <h2 class="mt-12 text-xs uppercase tracking-wide text-neutral-500">Shipping</h2>

    <% {
         name: ["Full name", "name"],
         line1: ["Address", "address-line1"],
         line2: ["Address line 2", "address-line2"],
         city: ["City", "address-level2"],
         region: ["Region", "address-level1"],
         postal_code: ["Postal code", "postal-code"],
         country: ["Country", "country-name"]
       }.each do |part, (label, autocomplete)| %>
      <div class="mt-4">
        <%= form.label :"shipping_#{part}", label, class: "block text-base" %>
        <%= form.text_field :"shipping_#{part}", value: @form.shipping.public_send(part),
              autocomplete: autocomplete, required: part != :line2,
              class: "mt-2 block w-full rounded-lg border border-neutral-300 px-4 py-3 text-lg" %>
      </div>
    <% end %>

    <% if customer_signed_in? %>
      <h2 class="mt-12 text-xs uppercase tracking-wide text-neutral-500">Payment</h2>
      <%= render "shop/card_fields", form: form %>
    <% end %>

    <%= form.submit "Place order", class: "mt-10 rounded-full bg-neutral-900 px-8 py-3 text-base text-white" %>
  <% end %>

  <aside>
    <h2 class="text-xs uppercase tracking-wide text-neutral-500">Order</h2>

    <ul class="mt-4 divide-y divide-neutral-100 border-y border-neutral-100">
      <% @items.each do |item| %>
        <li class="flex items-baseline justify-between gap-6 py-4">
          <span class="text-base"><%= item.listing.title %> &times; <%= item.quantity %></span>
          <span class="text-base"><%= item.total.format %></span>
        </li>
      <% end %>
    </ul>

    <p class="mt-6 flex items-baseline justify-between text-lg">
      <span>Total</span>
      <span data-checkout-total><%= @subtotal.format %></span>
    </p>
  </aside>
</div>
