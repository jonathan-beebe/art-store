<% content_for :title, "Order ##{@order.id} — Art Store" %>

<h1 class="text-4xl font-light tracking-tight">Order #<%= @order.id %></h1>

<p class="mt-3 text-lg text-neutral-500">
  <span data-order-status><%= status_label(@order.status) %></span> &middot; <%= @order.total.format %>
</p>

<% if @unpaid && !@payable %>
  <div role="status" data-verification-notice
       class="mt-10 max-w-xl rounded-2xl border border-emerald-200 bg-emerald-50 p-6 text-emerald-900">
    <p class="text-lg">Check your email</p>
    <p class="mt-2 text-base">
      A link is on its way to <%= @order.email %>. Open it to verify your address and pay for this order.
    </p>
    <p class="mt-4 text-base">
      <%= link_to "Already verified? Sign in to pay", shop_order_payment_path(@order), class: "underline" %>
    </p>
  </div>
<% end %>

<% if @payable %>
  <section class="mt-10 max-w-xl rounded-2xl border border-neutral-200 p-6">
    <h2 class="text-lg">Payment</h2>

    <%= render "shop/decline_notice", payment: @payment %>

    <%= form_with url: shop_pay_order_path(@order), method: :post, class: "mt-4" do |form| %>
      <%= render "shop/card_fields", form: form %>

      <%= form.submit "Pay #{@order.total.format}", class: "mt-8 rounded-full bg-neutral-900 px-8 py-3 text-base text-white" %>
    <% end %>
  </section>
<% end %>

<div class="mt-14 grid gap-14 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
  <div>
    <% @fulfillments.each do |fulfillment| %>
      <section class="border-t border-neutral-100 py-8 first:border-t-0 first:pt-0">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <h2 class="text-lg"><%= fulfillment.seller.display_name %></h2>
          <p data-fulfillment-status class="text-base text-neutral-500"><%= status_label(fulfillment.status) %></p>
        </div>

        <% if fulfillment.carrier.present? %>
          <p data-tracking class="mt-2 text-base text-neutral-500">
            <%= fulfillment.carrier %> &middot; tracking <%= fulfillment.tracking_number %>
          </p>
        <% end %>

        <ul class="mt-4 space-y-2">
          <% @items_by_seller.fetch(fulfillment.seller_id, []).each do |item| %>
            <li class="flex items-baseline justify-between gap-6 text-base">
              <span><%= item.title %> &times; <%= item.quantity %></span>
              <span><%= money(item.unit_price_cents * item.quantity) %></span>
            </li>
          <% end %>
        </ul>

        <% if fulfillment.shipped? %>
          <%= button_to "Confirm delivery", shop_confirm_delivery_path(order_id: @order.id, id: fulfillment.id),
                method: :post, form_class: "mt-6",
                class: "rounded-full border border-neutral-300 px-6 py-2 text-base hover:border-neutral-900" %>
        <% end %>
      </section>
    <% end %>
  </div>

  <aside>
    <h2 class="text-xs uppercase tracking-wide text-neutral-500">Shipping to</h2>
    <address class="mt-4 text-base not-italic leading-relaxed text-neutral-700">
      <%= @order.shipping_name %><br>
      <%= @order.shipping_line1 %><br>
      <% if @order.shipping_line2.present? %><%= @order.shipping_line2 %><br><% end %>
      <%= @order.shipping_city %>, <%= @order.shipping_region %><br>
      <%= @order.shipping_postal_code %><br>
      <%= @order.shipping_country %>
    </address>
  </aside>
</div>
