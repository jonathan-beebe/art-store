<% content_for :title, "Art Store" %>

<div class="flex flex-wrap items-end justify-between gap-8">
  <h1 class="max-w-2xl text-4xl font-light leading-tight tracking-tight">
    <% if @term %>
      Art matching &ldquo;<%= @term %>&rdquo;
    <% else %>
      Original work, direct from the studio
    <% end %>
  </h1>

  <%= form_with url: root_path, method: :get, class: "flex items-end gap-3" do |form| %>
    <%= form.hidden_field :q, value: @term %>
    <div>
      <%= form.label :medium, "Medium", class: "block text-xs uppercase tracking-wide text-neutral-500" %>
      <%= form.select :medium,
            options_for_select(@media, @medium),
            { include_blank: "All media" },
            class: "mt-2 rounded-lg border border-neutral-200 px-4 py-2 text-base" %>
    </div>
    <%= form.submit "Filter", class: "rounded-lg border border-neutral-300 px-5 py-2 text-base hover:border-neutral-900" %>
  <% end %>
</div>

<% if @listings.empty? %>
  <p class="mt-16 text-lg text-neutral-500">No art matches that yet.</p>
<% else %>
  <ul class="mt-14 grid grid-cols-1 gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
    <% @listings.each do |listing| %>
      <li><%= render "shop/listing_card", listing: listing %></li>
    <% end %>
  </ul>

  <nav aria-label="Pages" class="mt-16 flex items-baseline gap-6 text-sm">
    <% unless @page.first? %>
      <%= link_to "Previous", root_path(request.query_parameters.merge(page: @page.previous_number)),
            rel: "prev", class: "underline" %>
    <% end %>
    <span class="text-neutral-500">Page <%= @page.number %> of <%= @page.count %></span>
    <% unless @page.last? %>
      <%= link_to "Next", root_path(request.query_parameters.merge(page: @page.next_number)),
            rel: "next", class: "underline" %>
    <% end %>
  </nav>
<% end %>
