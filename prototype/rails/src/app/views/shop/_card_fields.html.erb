<div class="mt-4">
  <%= form.label :card_number, "Card number", class: "block text-base" %>
  <%= form.text_field :card_number, required: true, inputmode: "numeric", autocomplete: "cc-number",
        placeholder: "4242 4242 4242 4242",
        class: "mt-2 block w-full rounded-lg border border-neutral-300 px-4 py-3 text-lg" %>
</div>

<div class="mt-4 flex gap-4">
  <div class="flex-1">
    <%= form.label :card_expiry, "Expiry", class: "block text-base" %>
    <%= form.text_field :card_expiry, autocomplete: "cc-exp", placeholder: "04 / 30",
          class: "mt-2 block w-full rounded-lg border border-neutral-300 px-4 py-3 text-lg" %>
  </div>

  <div class="flex-1">
    <%= form.label :card_cvc, "CVC", class: "block text-base" %>
    <%= form.text_field :card_cvc, autocomplete: "cc-csc", placeholder: "123",
          class: "mt-2 block w-full rounded-lg border border-neutral-300 px-4 py-3 text-lg" %>
  </div>
</div>
