<% content_for :title, "Your account — Art Store" %>

<h1 class="text-4xl font-light tracking-tight">Your account</h1>

<dl class="mt-10 max-w-md">
  <dt class="text-xs uppercase tracking-wide text-neutral-500">Email</dt>
  <dd data-account-email class="mt-1 text-lg"><%= current_customer.email %></dd>
</dl>

<div class="mt-8 flex flex-wrap gap-3">
  <%= button_to "Contact support", shop_support_path, method: :post,
        class: "rounded-full bg-neutral-900 px-6 py-2 text-base text-white" %>

  <%= button_to "Sign out", customer_logout_path, method: :post,
        class: "rounded-full border border-neutral-300 px-6 py-2 text-base hover:border-neutral-900" %>
</div>

<h2 class="mt-16 text-2xl font-light tracking-tight">Notifications</h2>

<% if @notifications.empty? %>
  <p class="mt-6 text-lg text-neutral-500">Nothing yet. Order updates land here.</p>
<% else %>
  <ul class="mt-6 max-w-2xl divide-y divide-neutral-100 border-y border-neutral-100">
    <% @notifications.each do |notification| %>
      <li data-notification class="flex flex-wrap items-start justify-between gap-6 py-5">
        <div>
          <p class="text-lg"><%= notification.subject %></p>
          <p class="mt-1 text-base text-neutral-500"><%= notification.body %></p>
        </div>

        <% if notification.read_at.nil? %>
          <%= button_to "Mark as read", shop_read_notification_path(id: notification.id), method: :post,
                class: "text-sm text-neutral-500 underline hover:text-neutral-900" %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
