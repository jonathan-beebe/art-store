<% content_for :title, "Sign in — Art Store admin" %>

<div class="mx-auto max-w-md">
  <h1 class="text-lg font-semibold">Sign in to the admin site</h1>
  <p class="mt-1 text-slate-400">No password, and no sign-up: operators are seeded.</p>

  <%= form_with url: admin_send_magic_link_path, method: :post, class: "mt-6 space-y-3" do |form| %>
    <%= form.label :email, "Email address", class: "block font-medium" %>
    <%= form.email_field :email, value: params[:email], required: true, autofocus: true,
          class: "w-full border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100" %>
    <%= form.submit "Send sign-in link", class: "bg-slate-100 px-4 py-2 text-slate-900" %>
  <% end %>
</div>
