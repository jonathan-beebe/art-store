<% content_for :title, "Site stats — Art Store admin" %>

<h1 class="text-lg font-semibold">Site stats</h1>

<section aria-labelledby="listing-events-heading" class="mt-6">
  <h2 id="listing-events-heading" class="font-semibold text-slate-300">Listing activity</h2>
  <dl class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <% @listing_event_tallies.each do |event_type, count| %>
      <%= render "admin/shared/stat", key: "event-#{event_type}", label: status_label(event_type), value: count %>
    <% end %>
  </dl>
</section>

<section aria-labelledby="views-by-day-heading" class="mt-6">
  <h2 id="views-by-day-heading" class="font-semibold text-slate-300">Page views by day</h2>

  <% if @page_views_by_day.empty? %>
    <%= render "admin/shared/empty", key: "views_by_day", message: "No traffic recorded yet." %>
  <% else %>
    <%= render "admin/shared/table",
          caption: "Page views by day, newest first",
          headings: [ "Day", "Views" ],
          rows: render(partial: "admin/stats/day_count", collection: @page_views_by_day, as: :day_count) %>
  <% end %>
</section>

<section aria-labelledby="views-by-pattern-heading" class="mt-6">
  <h2 id="views-by-pattern-heading" class="font-semibold text-slate-300">Page views by route pattern</h2>

  <% if @page_views_by_pattern.empty? %>
    <%= render "admin/shared/empty", key: "views_by_pattern", message: "No traffic recorded yet." %>
  <% else %>
    <%= render "admin/shared/table",
          caption: "Page views by route pattern, busiest first",
          headings: [ "Pattern", "Site", "Views" ],
          rows: render(partial: "admin/stats/pattern_count", collection: @page_views_by_pattern, as: :pattern_count) %>
  <% end %>
</section>
