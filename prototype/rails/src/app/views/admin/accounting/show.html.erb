<% content_for :title, "Accounting — Art Store admin" %>

<h1 class="text-lg font-semibold">Accounting</h1>

<dl class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
  <%= render "admin/shared/stat", key: "held", label: "Held in escrow", value: @money.held.format %>
  <%= render "admin/shared/stat", key: "available", label: "Released, awaiting payout", value: @money.available.format %>
  <%= render "admin/shared/stat", key: "paid-out", label: "Paid out", value: @money.paid_out.format %>
  <%= render "admin/shared/stat", key: "fees-earned", label: "Fees earned", value: @money.fees_earned.format %>
  <%= render "admin/shared/stat", key: "fees-refunded", label: "Fees refunded", value: @money.fees_refunded.format %>
  <%= render "admin/shared/stat", key: "refunded", label: "Refunded", value: @money.refunded.format %>
</dl>

<h2 class="mt-6 font-semibold text-slate-300">Every seller</h2>

<% if @accounts.empty? %>
  <%= render "admin/shared/empty", key: "accounts", message: "Nobody has opened a shop yet." %>
<% else %>
  <%= render "admin/shared/table",
        caption: "Every seller's escrow balance beside the fees they earned and the fees they were refunded",
        headings: [ "Shop", "Held", "Available", "Paid out", "Refunded", "Fees earned", "Fees refunded" ],
        rows: render(partial: "admin/accounting/account", collection: @accounts, as: :account) %>
<% end %>
