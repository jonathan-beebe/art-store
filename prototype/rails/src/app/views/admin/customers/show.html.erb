<% content_for :title, "#{@customer.display_name} — Art Store admin" %>

<p><%= link_to "Customers", admin_customers_path, class: "text-slate-400 underline" %></p>

<div class="mt-2 flex flex-wrap items-center gap-4">
  <h1 class="text-lg font-semibold"><%= @customer.display_name %></h1>

  <% unless @customer.anonymous? %>
    <%= button_to "Message", admin_customer_conversation_path(@customer), form_class: "ml-auto",
          class: "bg-slate-100 px-3 py-1 font-medium text-slate-900" %>
  <% end %>
</div>

<dl class="mt-4 grid gap-3 rounded border border-slate-700 bg-slate-800 p-4 sm:grid-cols-3">
  <div>
    <dt class="text-slate-400">Email</dt>
    <dd data-field="email" class="mt-1"><%= @customer.email %></dd>
  </div>

  <div>
    <dt class="text-slate-400">Name</dt>
    <dd data-field="name" class="mt-1"><%= @customer.name %></dd>
  </div>

  <div>
    <dt class="text-slate-400">Standing</dt>
    <dd data-field="standing" class="mt-1"><%= customer_standing(@customer) %></dd>
  </div>

  <div>
    <dt class="text-slate-400">Blocked</dt>
    <dd data-field="blocked" class="mt-1"><%= @customer.blocked? ? "Blocked" : "Not blocked" %></dd>
  </div>

  <div>
    <dt class="text-slate-400">Orders</dt>
    <dd data-field="orders" class="mt-1 tabular-nums"><%= @orders.size %></dd>
  </div>

  <div>
    <dt class="text-slate-400">Favorites</dt>
    <dd data-field="favorites" class="mt-1 tabular-nums"><%= @favorites.size %></dd>
  </div>

  <div>
    <dt class="text-slate-400">Cart lines</dt>
    <dd data-field="cart_lines" class="mt-1 tabular-nums"><%= @cart_items.size %></dd>
  </div>
</dl>

<section aria-labelledby="orders-heading" class="mt-6">
  <h2 id="orders-heading" class="font-semibold text-slate-300">Orders</h2>

  <% if @orders.empty? %>
    <%= render "admin/shared/empty", key: "customer_orders", message: "This customer has ordered nothing." %>
  <% else %>
    <%= render "admin/shared/table",
          caption: "Every order this customer has placed, newest first",
          headings: [ "Order", "Customer", "Status", "Items", "Total", "Fulfillments", "Placed" ],
          rows: render(partial: "admin/orders/order", collection: @orders) %>
  <% end %>
</section>

<section aria-labelledby="favorites-heading" class="mt-6">
  <h2 id="favorites-heading" class="font-semibold text-slate-300">Favorites</h2>

  <% if @favorites.empty? %>
    <%= render "admin/shared/empty", key: "customer_favorites", message: "This customer has saved nothing." %>
  <% else %>
    <%= render "admin/shared/table",
          caption: "Everything this customer has saved, newest first",
          headings: [ "Listing", "Saved" ],
          rows: render(partial: "admin/customers/favorite", collection: @favorites) %>
  <% end %>
</section>

<section aria-labelledby="cart-heading" class="mt-6">
  <h2 id="cart-heading" class="font-semibold text-slate-300">Cart</h2>

  <% if @cart_items.empty? %>
    <%= render "admin/shared/empty", key: "customer_cart", message: "This customer's cart is empty." %>
  <% else %>
    <%= render "admin/shared/table",
          caption: "What this customer is holding in a cart",
          headings: [ "Listing", "Qty" ],
          rows: render(partial: "admin/customers/cart_item", collection: @cart_items) %>
  <% end %>
</section>

<section aria-labelledby="blocks-heading" class="mt-6">
  <h2 id="blocks-heading" class="font-semibold text-slate-300">Block history</h2>

  <% if @blocks.empty? %>
    <%= render "admin/shared/empty", key: "customer_blocks", message: "Nobody has blocked this customer." %>
  <% else %>
    <%= render "admin/shared/table",
          caption: "Every block placed on this customer, oldest first",
          headings: [ "Reason", "Admin", "Blocked", "Lifted" ],
          rows: render(partial: "admin/customers/block", collection: @blocks, as: :block) %>
  <% end %>

  <% if @customer.blocked? %>
    <%= button_to "Lift block", lift_admin_customer_blocks_path(@customer), method: :post,
          form_class: "mt-4",
          class: "rounded border border-slate-600 bg-slate-900 px-3 py-1 font-medium" %>
  <% else %>
    <%= form_with url: admin_customer_blocks_path(@customer), method: :post,
          html: { class: "mt-4 max-w-xl rounded border border-slate-700 bg-slate-800 p-4" } do |form| %>
      <div>
        <%= form.label :reason, "Why", class: "block text-slate-400" %>
        <%= form.text_area :reason, rows: 3, required: true, maxlength: 500,
              class: "mt-1 block w-full rounded border border-slate-600 bg-slate-900 px-3 py-2" %>
      </div>

      <%= form.submit "Block customer", class: "mt-4 rounded bg-slate-100 px-3 py-1 font-medium text-slate-900" %>
    <% end %>
  <% end %>
</section>

<section aria-labelledby="merges-heading" class="mt-6">
  <h2 id="merges-heading" class="font-semibold text-slate-300">Merge history</h2>

  <% if @merges.empty? %>
    <%= render "admin/shared/empty", key: "customer_merges", message: "No identity has been folded into or out of this one." %>
  <% else %>
    <%= render "admin/shared/table",
          caption: "Every anonymous identity folded into or out of this customer, oldest first",
          headings: [ "Direction", "Other identity", "Merged" ],
          rows: render(partial: "admin/customers/merge", collection: @merges, as: :merge) %>
  <% end %>
</section>
