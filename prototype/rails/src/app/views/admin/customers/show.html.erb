<% content_for :title, "#{@customer.display_name} — Art Store admin" %>

<p><%= link_to "Customers", admin_root_path(anchor: "customers"), class: "text-slate-400 underline" %></p>

<div class="mt-2 flex flex-wrap items-center gap-4">
  <h1 class="text-lg font-semibold"><%= @customer.display_name %></h1>
  <%= button_to "Message", admin_customer_conversation_path(@customer), form_class: "ml-auto",
        class: "bg-slate-100 px-3 py-1 font-medium text-slate-900" %>
</div>

<dl class="mt-4 grid gap-3 rounded border border-slate-700 bg-slate-800 p-4 sm:grid-cols-3">
  <div>
    <dt class="text-slate-400">Email</dt>
    <dd data-field="email" class="mt-1"><%= @customer.email %></dd>
  </div>

  <div>
    <dt class="text-slate-400">Name</dt>
    <dd data-field="name" class="mt-1"><%= @customer.name %></dd>
  </div>

  <div>
    <dt class="text-slate-400">Orders</dt>
    <dd data-field="orders" class="mt-1 tabular-nums"><%= @order_count %></dd>
  </div>
</dl>
