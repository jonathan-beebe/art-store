<tr data-customer="<%= row.id %>">
  <th scope="row" class="px-4 py-2 font-normal">
    <%= link_to row.display_name, admin_customer_path(row.customer), class: "font-medium underline" %>
  </th>
  <td class="px-4 py-2 text-slate-400"><%= row.email %></td>
  <td data-cell="standing" class="px-4 py-2"><%= customer_standing(row) %></td>
  <td data-cell="orders" class="px-4 py-2 text-right tabular-nums"><%= row.order_count %></td>
  <td data-cell="favorites" class="px-4 py-2 text-right tabular-nums"><%= row.favorite_count %></td>
  <td data-cell="cart_lines" class="px-4 py-2 text-right tabular-nums"><%= row.cart_line_count %></td>
</tr>
