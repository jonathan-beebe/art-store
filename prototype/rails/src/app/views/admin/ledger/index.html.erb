<% content_for :title, "Ledger — Art Store admin" %>

<h1 class="text-lg font-semibold">Ledger</h1>

<%= render "admin/shared/filters", url: admin_ledger_path, fields: [
      { name: :seller, label: "Seller", selected: @seller_id,
        options: [ [ "All sellers", "" ] ] + @sellers.map { |seller| [ seller.display_name, seller.id ] } },
      { name: :type, label: "Type", selected: @entry_type,
        options: [ [ "All types", "" ] ] + LedgerEntry.entry_types.keys.map { |type| [ status_label(type), type ] } }
    ] %>

<h2 class="mt-4 sr-only">Totals for the filtered set</h2>
<dl class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
  <%= render "admin/shared/stat", key: "held", label: "Held", value: @totals.held.format %>
  <%= render "admin/shared/stat", key: "available", label: "Available", value: @totals.available.format %>
  <%= render "admin/shared/stat", key: "paid-out", label: "Paid out", value: @totals.paid_out.format %>
</dl>

<% if @entries.empty? %>
  <%= render "admin/shared/empty", key: "entries", message: "No ledger entry matches that filter." %>
<% else %>
  <%= render "admin/shared/table",
        caption: "Every ledger entry matching the filter, newest first",
        headings: [ "Occurred", "Seller", "Type", "Amount", "Fulfillment", "Payout" ],
        rows: render(partial: "admin/ledger/entry", collection: @entries, as: :entry) %>
<% end %>
