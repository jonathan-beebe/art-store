<tr data-entry="<%= entry.id %>">
  <th scope="row" class="px-4 py-2 font-normal text-slate-400">
    <%= entry.occurred_at.strftime("%b %-d, %Y %H:%M") %>
  </th>
  <td class="px-4 py-2">
    <%= link_to entry.seller.display_name, admin_seller_path(entry.seller), class: "underline" %>
  </td>
  <td data-cell="entry_type" class="px-4 py-2"><%= status_label(entry.entry_type) %></td>
  <td data-cell="amount" class="px-4 py-2 text-right tabular-nums"><%= money(entry.amount_cents) %></td>
  <td class="px-4 py-2 text-slate-400"><%= entry.fulfillment_id %></td>
  <td class="px-4 py-2 text-slate-400"><%= entry.payout_id %></td>
</tr>
