<% content_for :title, "Payouts — Art Store admin" %>

<h1 class="text-lg font-semibold">Payouts</h1>

<%= render "admin/shared/filters", url: admin_payouts_path, fields: [
      { name: :seller, label: "Seller", selected: @seller_id,
        options: [ [ "All sellers", "" ] ] + @sellers.map { |seller| [ seller.display_name, seller.id ] } }
    ] %>

<% if @payouts.empty? %>
  <%= render "admin/shared/empty", key: "payouts", message: "No payout matches that filter." %>
<% else %>
  <%= render "admin/shared/table",
        caption: "Every payout across every seller, newest first",
        headings: [ "Seller", "Period", "Amount", "Paid" ],
        rows: render(partial: "admin/payouts/payout", collection: @payouts) %>
<% end %>

<%= form_with url: admin_payouts_path, method: :post,
      html: { class: "mt-6 max-w-xl rounded border border-slate-700 bg-slate-800 p-4" } do |form| %>
  <p class="text-slate-400">
    Runs the weekly payout for every seller, settling the Monday-to-Sunday week that
    ended before the date given (today, if left blank). Running the same week twice
    pays nothing the second time.
  </p>

  <div class="mt-4">
    <%= form.label :as_of, "As of", class: "block text-slate-400" %>
    <%= form.date_field :as_of,
          class: "mt-1 rounded border border-slate-600 bg-slate-900 px-2 py-1" %>
  </div>

  <%= form.submit "Run weekly payout", class: "mt-4 rounded bg-slate-100 px-3 py-1 font-medium text-slate-900" %>
<% end %>
