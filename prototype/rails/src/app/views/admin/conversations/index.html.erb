<% content_for :title, "Messages — Art Store admin" %>

<h1 class="text-lg font-semibold">Messages</h1>

<% if @conversations.empty? %>
  <p class="mt-4 rounded border border-slate-700 bg-slate-800 p-4 text-slate-400">Nothing yet.</p>
<% else %>
  <ul class="mt-4 divide-y divide-slate-700 rounded border border-slate-700 bg-slate-800">
    <% @conversations.each do |conversation| %>
      <% unread = @unread_counts[conversation.id] %>
      <li data-conversation="<%= conversation.id %>" class="flex flex-wrap items-baseline gap-x-4 gap-y-1 p-4">
        <p class="font-medium">
          <%= link_to conversation.counterpart_of(current_admin).display_name,
                admin_conversation_path(conversation), class: "underline" %>
        </p>
        <p data-cell="topic" class="text-slate-400"><%= conversation.topic %></p>
        <span data-unread-count="<%= unread %>"
              class="rounded px-2 py-0.5 text-xs <%= unread.positive? ? "bg-slate-100 text-slate-900" : "bg-slate-700 text-slate-400" %>">
          <%= unread.positive? ? "#{unread} unread" : "Read" %>
        </span>
        <p class="ml-auto text-slate-400"><%= conversation.last_message_at.strftime("%b %-d, %Y %-l:%M%P") %></p>
      </li>
    <% end %>
  </ul>
<% end %>
