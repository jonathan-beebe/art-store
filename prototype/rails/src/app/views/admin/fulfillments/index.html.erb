<% content_for :title, "Fulfillments — Art Store admin" %>

<h1 class="text-lg font-semibold">Fulfillments (<%= @fulfillments.size %>)</h1>

<%= render "admin/shared/filters", url: admin_fulfillments_path, fields: [
      { name: :status, label: "Status", selected: @status,
        options: [ [ "All statuses", "" ] ] + Fulfillment.statuses.keys.map { |status| [ status_label(status), status ] } },
      { name: :seller, label: "Seller", selected: @seller_id,
        options: [ [ "All sellers", "" ] ] + @sellers.map { |seller| [ seller.display_name, seller.id ] } }
    ] %>

<% if @fulfillments.empty? %>
  <%= render "admin/shared/empty", key: "fulfillments", message: "No fulfillment matches that filter." %>
<% else %>
  <%= render "admin/shared/table",
        caption: "Every fulfillment across every seller, newest first",
        headings: [ "Fulfillment", "Order", "Seller", "Status", "Subtotal", "Fee", "Net", "" ],
        rows: render(partial: "admin/fulfillments/fulfillment", collection: @fulfillments) %>
<% end %>
