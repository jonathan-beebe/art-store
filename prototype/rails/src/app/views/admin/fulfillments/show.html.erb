<% content_for :title, "Fulfillment #{@fulfillment.id} — Art Store admin" %>

<p><%= link_to "Fulfillments", admin_fulfillments_path, class: "text-slate-400 underline" %></p>

<h1 class="mt-2 text-lg font-semibold">Fulfillment <%= @fulfillment.id %></h1>

<dl class="mt-4 grid gap-3 rounded border border-slate-700 bg-slate-800 p-4 sm:grid-cols-3">
  <div>
    <dt class="text-slate-400">Order</dt>
    <dd data-field="order" class="mt-1">
      <%= link_to @fulfillment.order_id, admin_order_path(@fulfillment.order), class: "underline" %>
    </dd>
  </div>

  <div>
    <dt class="text-slate-400">Seller</dt>
    <dd data-field="seller" class="mt-1">
      <%= link_to @fulfillment.seller.display_name, admin_seller_path(@fulfillment.seller), class: "underline" %>
    </dd>
  </div>

  <div>
    <dt class="text-slate-400">Status</dt>
    <dd data-field="status" class="mt-1"><%= status_label(@fulfillment.status) %></dd>
  </div>

  <div>
    <dt class="text-slate-400">Subtotal</dt>
    <dd data-field="subtotal" class="mt-1 tabular-nums"><%= @fulfillment.subtotal.format %></dd>
  </div>

  <div>
    <dt class="text-slate-400">Platform fee</dt>
    <dd data-field="fee" class="mt-1 tabular-nums"><%= @fulfillment.fee.format %></dd>
  </div>

  <div>
    <dt class="text-slate-400">Net to the seller</dt>
    <dd data-field="net" class="mt-1 tabular-nums"><%= @fulfillment.net.format %></dd>
  </div>

  <div>
    <dt class="text-slate-400">Carrier</dt>
    <dd data-field="carrier" class="mt-1"><%= @fulfillment.carrier %></dd>
  </div>

  <div>
    <dt class="text-slate-400">Tracking</dt>
    <dd data-field="tracking_number" class="mt-1"><%= @fulfillment.tracking_number %></dd>
  </div>
</dl>

<section aria-labelledby="items-heading" class="mt-6">
  <h2 id="items-heading" class="font-semibold text-slate-300">Items</h2>

  <% if @items.empty? %>
    <%= render "admin/shared/empty", key: "fulfillment_items", message: "This fulfillment ships no lines." %>
  <% else %>
    <%= render "admin/shared/table",
          caption: "The lines of the order this seller ships",
          headings: [ "Item", "Qty", "Unit price" ],
          rows: render(partial: "admin/orders/item", collection: @items, as: :item) %>
  <% end %>
</section>

<section aria-labelledby="refunds-heading" class="mt-6">
  <h2 id="refunds-heading" class="font-semibold text-slate-300">Refunds</h2>

  <% if @refunds.empty? %>
    <%= render "admin/shared/empty", key: "fulfillment_refunds", message: "Nothing has been sent back on this fulfillment." %>
  <% end %>
</section>
