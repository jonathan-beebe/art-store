<% content_for :title, "Dashboard — Art Store admin" %>

<h1 class="text-lg font-semibold">Dashboard</h1>

<section aria-labelledby="people-heading" class="mt-6">
  <h2 id="people-heading" class="font-semibold text-slate-300">People</h2>
  <dl class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <%= render "admin/shared/stat", key: "sellers", label: "Sellers", value: @seller_count %>
    <%= render "admin/shared/stat", key: "verified-customers", label: "Verified customers", value: @verified_customer_count %>
    <%= render "admin/shared/stat", key: "anonymous-customers", label: "Anonymous customers", value: @anonymous_customer_count %>
  </dl>
</section>

<section aria-labelledby="money-heading" class="mt-6">
  <div class="flex flex-wrap items-center gap-4">
    <h2 id="money-heading" class="font-semibold text-slate-300">Money</h2>
    <%= link_to "Accounting", admin_accounting_path, class: "ml-auto underline" %>
  </div>
  <dl class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <%= render "admin/shared/stat", key: "held", label: "Held in escrow", value: @money.held.format %>
    <%= render "admin/shared/stat", key: "available", label: "Released, awaiting payout", value: @money.available.format %>
    <%= render "admin/shared/stat", key: "paid-out", label: "Paid out", value: @money.paid_out.format %>
    <%= render "admin/shared/stat", key: "fees-earned", label: "Fees earned", value: @money.fees_earned.format %>
    <%= render "admin/shared/stat", key: "fees-refunded", label: "Fees refunded", value: @money.fees_refunded.format %>
    <%= render "admin/shared/stat", key: "refunded", label: "Refunded", value: @money.refunded.format %>
  </dl>
</section>

<section aria-labelledby="traffic-heading" class="mt-6">
  <div class="flex flex-wrap items-center gap-4">
    <h2 id="traffic-heading" class="font-semibold text-slate-300">Traffic</h2>
    <%= link_to "Site stats", admin_stats_path, class: "ml-auto underline" %>
  </div>
  <dl class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <%= render "admin/shared/stat", key: "views-this-week", label: "Page views this week", value: @page_views_this_week %>
  </dl>
</section>

<section aria-labelledby="listings-heading" class="mt-6">
  <div class="flex flex-wrap items-center gap-4">
    <h2 id="listings-heading" class="font-semibold text-slate-300">Listings</h2>
    <%= link_to "All listings", admin_listings_path, class: "ml-auto underline" %>
  </div>
  <dl class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <% @listing_tallies.each do |status, count| %>
      <%= render "admin/shared/stat", key: "listing-#{status}", label: status_label(status), value: count %>
    <% end %>
  </dl>
</section>

<section aria-labelledby="orders-heading" class="mt-6">
  <div class="flex flex-wrap items-center gap-4">
    <h2 id="orders-heading" class="font-semibold text-slate-300">Orders</h2>
    <%= link_to "All orders", admin_orders_path, class: "ml-auto underline" %>
  </div>
  <dl class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <% @order_tallies.each do |status, count| %>
      <%= render "admin/shared/stat", key: "order-#{status}", label: status_label(status), value: count %>
    <% end %>
  </dl>
</section>

<section aria-labelledby="fulfillments-heading" class="mt-6">
  <div class="flex flex-wrap items-center gap-4">
    <h2 id="fulfillments-heading" class="font-semibold text-slate-300">Fulfillments</h2>
    <%= link_to "All fulfillments", admin_fulfillments_path, class: "ml-auto underline" %>
  </div>
  <dl class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <% @fulfillment_tallies.each do |status, count| %>
      <%= render "admin/shared/stat", key: "fulfillment-#{status}", label: status_label(status), value: count %>
    <% end %>
  </dl>
</section>
