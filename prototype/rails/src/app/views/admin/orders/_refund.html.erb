<tr data-refund="<%= refund.id %>">
  <th scope="row" class="px-4 py-2 font-normal"><%= refund.id %></th>
  <td class="px-4 py-2">
    <%= link_to refund.fulfillment_id, admin_fulfillment_path(refund.fulfillment_id), class: "underline" %>
  </td>
  <td data-cell="amount" class="px-4 py-2 text-right tabular-nums"><%= money(refund.amount_cents) %></td>
  <td data-cell="issued_by" class="px-4 py-2"><%= refund.issued_by_type.capitalize %></td>
  <td data-cell="reason" class="px-4 py-2"><%= refund.reason %></td>
  <td class="px-4 py-2"><%= refund.created_at.strftime("%b %-d, %Y") %></td>
</tr>
