<% content_for :title, "Order #{@order.id} — Art Store admin" %>

<p><%= link_to "Orders", admin_orders_path, class: "text-slate-400 underline" %></p>

<h1 class="mt-2 text-lg font-semibold">Order <%= @order.id %></h1>

<dl class="mt-4 grid gap-3 rounded border border-slate-700 bg-slate-800 p-4 sm:grid-cols-3">
  <div>
    <dt class="text-slate-400">Customer</dt>
    <dd data-field="customer" class="mt-1">
      <%= link_to @order.customer.display_name, admin_customer_path(@order.customer), class: "underline" %>
    </dd>
  </div>

  <div>
    <dt class="text-slate-400">Status</dt>
    <dd data-field="status" class="mt-1">
      <%= status_label(@order.status) %>
      <% if @order.cancellation_reason.present? %>
        <p data-field="cancellation_reason" class="mt-1 text-slate-400">Reason: <%= @order.cancellation_reason %></p>
      <% end %>
    </dd>
  </div>

  <div>
    <dt class="text-slate-400">Placed</dt>
    <dd data-field="placed_at" class="mt-1"><%= @order.placed_at.strftime("%b %-d, %Y") %></dd>
  </div>

  <div>
    <dt class="text-slate-400">Total</dt>
    <dd data-field="total" class="mt-1 tabular-nums"><%= money(@order.total_cents) %></dd>
  </div>

  <div>
    <dt class="text-slate-400">Refunded</dt>
    <dd data-field="refunded" class="mt-1 tabular-nums"><%= money(@order.refunded_cents) %></dd>
  </div>

  <div class="sm:col-span-2">
    <dt class="text-slate-400">Ship to</dt>
    <dd data-field="shipping" class="mt-1">
      <%= @order.shipping_name %>, <%= @order.shipping_line1 %>, <%= @order.shipping_city %>,
      <%= @order.shipping_postal_code %>, <%= @order.shipping_country %>
    </dd>
  </div>
</dl>

<section aria-labelledby="items-heading" class="mt-6">
  <h2 id="items-heading" class="font-semibold text-slate-300">Items</h2>

  <% if @order.items.empty? %>
    <%= render "admin/shared/empty", key: "order_items", message: "This order holds no lines." %>
  <% else %>
    <%= render "admin/shared/table",
          caption: "Every line in this order",
          headings: [ "Item", "Qty", "Unit price" ],
          rows: render(partial: "admin/orders/item", collection: @order.items, as: :item) %>
  <% end %>
</section>

<section aria-labelledby="payments-heading" class="mt-6">
  <h2 id="payments-heading" class="font-semibold text-slate-300">Payments</h2>

  <% if @payments.empty? %>
    <%= render "admin/shared/empty", key: "order_payments", message: "No card has been tried on this order." %>
  <% else %>
    <%= render "admin/shared/table",
          caption: "Every card attempt on this order, newest first",
          headings: [ "Processed", "Card", "Amount", "Status", "Decline reason" ],
          rows: render(partial: "admin/orders/payment", collection: @payments, as: :payment) %>
  <% end %>
</section>

<section aria-labelledby="fulfillments-heading" class="mt-6">
  <h2 id="fulfillments-heading" class="font-semibold text-slate-300">Fulfillments</h2>

  <% if @fulfillments.empty? %>
    <%= render "admin/shared/empty", key: "order_fulfillments", message: "This order has not been split for shipping." %>
  <% else %>
    <%= render "admin/shared/table",
          caption: "One fulfillment per seller in this order",
          headings: [ "Fulfillment", "Order", "Seller", "Status", "Subtotal", "Fee", "Net", "" ],
          rows: render(partial: "admin/fulfillments/fulfillment", collection: @fulfillments) %>
  <% end %>
</section>

<section aria-labelledby="refunds-heading" class="mt-6">
  <h2 id="refunds-heading" class="font-semibold text-slate-300">Refunds</h2>

  <% if @refunds.empty? %>
    <%= render "admin/shared/empty", key: "order_refunds", message: "Nothing has been sent back on this order." %>
  <% else %>
    <%= render "admin/shared/table",
          caption: "Every refund issued against this order, newest first",
          headings: [ "Refund", "Fulfillment", "Amount", "Issued by", "Reason", "Issued" ],
          rows: render(partial: "admin/orders/refund", collection: @refunds) %>
  <% end %>
</section>

<% if @order.cancellable? %>
  <section aria-labelledby="cancel-heading" class="mt-6">
    <h2 id="cancel-heading" class="font-semibold text-slate-300">Cancel this order</h2>

    <%= form_with url: admin_order_cancellation_path(@order), method: :post,
          html: { class: "mt-4 max-w-xl rounded border border-slate-700 bg-slate-800 p-4" } do |form| %>
      <div>
        <%= form.label :reason, "Why", class: "block text-slate-400" %>
        <%= form.text_area :reason, rows: 3, required: true, maxlength: Refund::REASON_LIMIT,
              class: "mt-1 block w-full rounded border border-slate-600 bg-slate-900 px-3 py-2" %>
      </div>

      <%= form.submit "Cancel order", class: "mt-4 rounded bg-slate-100 px-3 py-1 font-medium text-slate-900" %>
    <% end %>
  </section>
<% end %>
