<% content_for :title, "Listings — Art Store admin" %>

<h1 class="text-lg font-semibold">Listings (<%= @listings.size %>)</h1>

<%= render "admin/shared/filters", url: admin_listings_path, fields: [
      { name: :status, label: "Status", selected: @status,
        options: [ [ "All statuses", "" ] ] + Listing.statuses.keys.map { |status| [ status_label(status), status ] } },
      { name: :seller, label: "Seller", selected: @seller_id,
        options: [ [ "All sellers", "" ] ] + @sellers.map { |seller| [ seller.display_name, seller.id ] } },
      { name: :removed, label: "Removal", selected: @removed,
        options: Listing::REMOVAL_STANDINGS.map { |standing| [ standing.humanize, standing ] } }
    ] %>

<% if @listings.empty? %>
  <%= render "admin/shared/empty", key: "listings", message: "No listing matches that filter." %>
<% else %>
  <%= render "admin/shared/table",
        caption: "Every listing across every seller, newest first",
        headings: [ "Listing", "Seller", "Status", "Price", "Qty", "Storefront" ],
        rows: render(partial: "admin/listings/listing", collection: @listings) %>
<% end %>
