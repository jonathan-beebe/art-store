<% content_for :title, "#{@listing.title} — Art Store admin" %>

<p><%= link_to "Listings", admin_listings_path, class: "text-slate-400 underline" %></p>

<h1 class="mt-2 text-lg font-semibold"><%= @listing.title %></h1>

<dl class="mt-4 grid gap-3 rounded border border-slate-700 bg-slate-800 p-4 sm:grid-cols-3">
  <div>
    <dt class="text-slate-400">Seller</dt>
    <dd data-field="seller" class="mt-1">
      <%= link_to @listing.seller.display_name, admin_seller_path(@listing.seller), class: "underline" %>
    </dd>
  </div>

  <div>
    <dt class="text-slate-400">Status</dt>
    <dd data-field="status" class="mt-1"><%= status_label(@listing.status) %></dd>
  </div>

  <div>
    <dt class="text-slate-400">Storefront</dt>
    <dd data-field="storefront" class="mt-1">
      <%= @listing.on_storefront? ? "On the storefront" : "Off the storefront" %>
    </dd>
  </div>

  <div>
    <dt class="text-slate-400">Removal</dt>
    <dd data-field="removed" class="mt-1">
      <%= @listing.actively_removed? ? "Removed" : "Not removed" %>
    </dd>
  </div>

  <div>
    <dt class="text-slate-400">Price</dt>
    <dd data-field="price" class="mt-1 tabular-nums"><%= money(@listing.price_cents) %></dd>
  </div>

  <div>
    <dt class="text-slate-400">Quantity</dt>
    <dd data-field="quantity" class="mt-1 tabular-nums"><%= @listing.quantity %></dd>
  </div>

  <div>
    <dt class="text-slate-400">Medium</dt>
    <dd data-field="medium" class="mt-1"><%= @listing.medium %></dd>
  </div>
</dl>

<section aria-labelledby="description-heading" class="mt-6">
  <h2 id="description-heading" class="font-semibold text-slate-300">Description</h2>

  <p data-field="description" class="mt-2 rounded border border-slate-700 bg-slate-800 p-4">
    <%= @listing.description %>
  </p>
</section>

<section aria-labelledby="removals-heading" class="mt-6">
  <h2 id="removals-heading" class="font-semibold text-slate-300">Removal history</h2>

  <% if @removals.empty? %>
    <%= render "admin/shared/empty", key: "listing_removals", message: "Nobody has removed this listing." %>
  <% else %>
    <%= render "admin/shared/table",
          caption: "Every removal placed on this listing, oldest first",
          headings: [ "Kind", "Reason", "Admin", "Removed", "Lifted" ],
          rows: render(partial: "admin/listings/removal", collection: @removals, as: :removal) %>
  <% end %>

  <% if @listing.actively_removed? %>
    <% if @listing.active_removal.liftable? %>
      <%= button_to "Lift removal", lift_admin_listing_removals_path(@listing), method: :post,
            form_class: "mt-4",
            class: "rounded border border-slate-600 bg-slate-900 px-3 py-1 font-medium" %>
    <% else %>
      <p class="mt-4 text-slate-400">A permanent removal cannot be lifted.</p>
    <% end %>
  <% else %>
    <%= form_with url: admin_listing_removals_path(@listing), method: :post,
          html: { class: "mt-4 max-w-xl rounded border border-slate-700 bg-slate-800 p-4" } do |form| %>
      <div>
        <%= form.label :kind, "Kind", class: "block text-slate-400" %>
        <%= form.select :kind, ListingRemoval.kinds.keys.map { |kind| [ status_label(kind), kind ] },
              {}, class: "mt-1 rounded border border-slate-600 bg-slate-900 px-2 py-1" %>
      </div>

      <div class="mt-4">
        <%= form.label :reason, "Why", class: "block text-slate-400" %>
        <%= form.text_area :reason, rows: 3, required: true, maxlength: 500,
              class: "mt-1 block w-full rounded border border-slate-600 bg-slate-900 px-3 py-2" %>
      </div>

      <%= form.submit "Remove listing", class: "mt-4 rounded bg-slate-100 px-3 py-1 font-medium text-slate-900" %>
    <% end %>
  <% end %>
</section>
