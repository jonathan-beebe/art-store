<tr data-seller="<%= row.id %>">
  <th scope="row" class="px-4 py-2 font-normal">
    <%= link_to row.display_name, admin_seller_path(row.seller), class: "font-medium underline" %>
  </th>
  <td class="px-4 py-2 text-slate-400"><%= row.email %></td>
  <td data-cell="listings" class="px-4 py-2 text-right tabular-nums"><%= row.listing_count %></td>
  <td data-cell="fulfillments" class="px-4 py-2 text-right tabular-nums"><%= row.fulfillment_count %></td>
  <td data-cell="held" class="px-4 py-2 text-right tabular-nums"><%= row.balance.held.format %></td>
  <td data-cell="available" class="px-4 py-2 text-right tabular-nums"><%= row.balance.available.format %></td>
  <td data-cell="paid_out" class="px-4 py-2 text-right tabular-nums"><%= row.balance.paid_out.format %></td>
</tr>
