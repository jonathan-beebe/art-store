# Mirrors and extends .gitignore: keep the build context small and keep
# host-only state (installed deps, generated assets, the database, uploads)
# out of every image, dev included — the build stage installs and builds its
# own copies.
src/node_modules/
src/coverage/
src/public/app.css
src/public/app.*.css
src/public/app.*.css.gz
src/public/app.*.css.br
src/public/app.*.js
src/public/app.*.js.gz
src/public/app.*.js.br
src/public/assets-manifest.json
src/public/uploads/
src/storage/*.sqlite3
src/storage/*.sqlite3-shm
src/storage/*.sqlite3-wal

docs/
work/
__local__/
.git/
