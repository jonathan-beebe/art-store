{
  "name": "art-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15" },
  "//": "node:sqlite is a release candidate, so Node 24.12 prints an ExperimentalWarning on import; --disable-warning silences it. Node 24.15 and later print nothing and the flag becomes a no-op. The test runner gives each test file its own process, which inherits NODE_OPTIONS but not the parent's flags.",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning app/server.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch app/server.ts",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning node --test 'app/**/*.test.ts'",
    "//coverage": "NODE_DISABLE_COMPILE_CACHE keeps the gate's numbers deterministic: code restored from the V8 compile cache reports different precise-block-coverage counts than freshly compiled code.",
    "coverage": "mkdir -p coverage && NODE_DISABLE_COMPILE_CACHE=1 NODE_OPTIONS=--disable-warning=ExperimentalWarning node --test --experimental-test-coverage --test-coverage-include='app/**' --test-coverage-exclude='app/**/*.test.ts' --test-coverage-lines=95 --test-coverage-branches=90 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info 'app/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && eslint --cache --cache-location .cache/eslint/ app",
    "lint:fix": "eslint --cache --cache-location .cache/eslint/ app --fix",
    "check": "npm run lint && npm run assets && npm run coverage",
    "assets": "tailwindcss --input app/assets/app.css --output public/app.css && node --disable-warning=ExperimentalWarning app/cli/build-assets.ts",
    "migrate": "node --disable-warning=ExperimentalWarning app/db/migrate.ts",
    "fresh": "node --disable-warning=ExperimentalWarning app/db/migrate.ts --fresh",
    "seed": "node --disable-warning=ExperimentalWarning app/db/seed.ts",
    "payouts": "node --disable-warning=ExperimentalWarning app/cli/run-payouts.ts",
    "outbox": "node --disable-warning=ExperimentalWarning app/cli/drain-outbox.ts",
    "sweep": "node --disable-warning=ExperimentalWarning app/cli/sweep-stale-orders.ts",
    "routes": "node --disable-warning=ExperimentalWarning app/cli/print-routes.ts",
    "deploy": "node --disable-warning=ExperimentalWarning app/cli/prepare-db.ts && npm run start"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^12.0.0",
    "ejs": "^6.0.1",
    "fastify": "^5.12.1",
    "kysely": "^0.29.5",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39",
    "@tailwindcss/cli": "^4.3.3",
    "@types/ejs": "^3.1.5",
    "@types/node": "^24",
    "eslint": "^9.39",
    "typescript": "^5.9",
    "typescript-eslint": "^8.48.0"
  }
}
