{
  "name": "art-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node app/server.ts",
    "dev": "node --watch app/server.ts",
    "test": "node --test 'app/**/*.test.ts'",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='app/**' --test-coverage-exclude='app/**/*.test.ts' --test-coverage-lines=90 --test-coverage-branches=80 'app/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app",
    "check": "npm run typecheck && npm run lint && npm test",
    "assets": "tailwindcss --input app/assets/app.css --output public/app.css",
    "migrate": "node app/db/migrate.ts",
    "fresh": "node app/db/migrate.ts --fresh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^12.0.0",
    "better-sqlite3": "^13.0.3",
    "ejs": "^6.0.1",
    "fastify": "^5.12.1",
    "kysely": "^0.29.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39",
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ejs": "^3.1.5",
    "@types/node": "^24",
    "eslint": "^9.39",
    "typescript": "^5.9",
    "typescript-eslint": "^8.48.0"
  }
}
