<% if (page.count > 1) { %>
<nav aria-label="Pages" class="mt-8 flex items-baseline gap-6 text-sm">
  <% if (!page.isFirst) { %>
  <a
    rel="prev"
    href="<%= basePath %>?<%= [query, param + '=' + page.previousNumber].filter(Boolean).join('&') %>"
    class="underline"
    >Previous</a
  >
  <% } %>
  <span class="text-neutral-600 dark:text-neutral-400">Page <%= page.number %> of <%= page.count %></span>
  <% if (!page.isLast) { %>
  <a
    rel="next"
    href="<%= basePath %>?<%= [query, param + '=' + page.nextNumber].filter(Boolean).join('&') %>"
    class="underline"
    >Next</a
  >
  <% } %>
</nav>
<% } %>
