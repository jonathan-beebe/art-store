<% if (flash.notice) { %>
  <p role="status" class="border-b border-emerald-300 dark:border-emerald-900 bg-emerald-50 dark:bg-emerald-950/40 px-6 py-3 text-sm text-emerald-900 dark:text-emerald-200"><%= flash.notice %></p>
<% } %>
<% if (flash.alert) { %>
  <p role="alert" class="border-b border-rose-300 dark:border-rose-900 bg-rose-50 dark:bg-rose-950/40 px-6 py-3 text-sm text-rose-900 dark:text-rose-200"><%= flash.alert %></p>
<% } %>
