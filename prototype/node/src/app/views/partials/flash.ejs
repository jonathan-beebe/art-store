<% if (flash.notice) { %>
  <p role="status" class="border-b border-emerald-300 bg-emerald-50 px-6 py-3 text-sm text-emerald-900"><%= flash.notice %></p>
<% } %>
<% if (flash.alert) { %>
  <p role="alert" class="border-b border-rose-300 bg-rose-50 px-6 py-3 text-sm text-rose-900"><%= flash.alert %></p>
<% } %>
