<h1 class="text-2xl font-semibold">Sign in to the seller portal</h1>
<p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
  There's no password: submit your address and we send a sign-in link. In this
  prototype the link is printed at the top of this page instead of emailed.
</p>
<form method="post" action="<%= loginPath %>" class="mt-6 max-w-sm space-y-4">
  <%- include('views/partials/csrf-field', { csrfToken }) %>
  <%- include('views/partials/form-error', { formError: typeof formError !== 'undefined' ? formError : null }) %>
  <%- include('views/partials/form-field', {
    name: 'email',
    label: 'Email address',
    type: 'email',
    value: typeof email !== 'undefined' ? email : '',
    error: typeof error !== 'undefined' ? error : null,
    required: true,
    autofocus: true,
    wrapperClass: '',
    inputClass: 'mt-1 block w-full rounded border border-neutral-300 dark:border-neutral-700 px-3 py-2 text-sm',
  }) %>
  <% if (redirectTo) { %>
  <input type="hidden" name="redirect_to" value="<%= redirectTo %>" />
  <% } %>
  <button
    type="submit"
    class="cursor-pointer rounded bg-neutral-900 dark:bg-neutral-100 px-4 py-2 text-sm font-medium text-white dark:text-neutral-900"
  >
    Email me a sign-in link
  </button>
</form>
