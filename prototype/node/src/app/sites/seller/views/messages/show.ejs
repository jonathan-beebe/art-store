<div class="flex flex-wrap items-center gap-4">
  <h1 class="text-2xl font-semibold"><%= thread.topic %></h1>
  <p class="text-sm text-neutral-600 dark:text-neutral-400">with <%= thread.counterpart %></p>
  <a href="/seller/messages" class="ml-auto text-sm underline">All messages</a>
</div>

<ul class="mt-6 space-y-3">
  <% thread.messages.forEach(function (message) { %>
    <li data-message="<%= message.id %>" class="rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 p-4 text-sm">
      <p class="flex flex-wrap items-center gap-2 text-neutral-600 dark:text-neutral-400">
        <span class="font-medium text-neutral-900 dark:text-neutral-100"><%= message.senderName %></span>
        <span><%= formatDateTime(message.sentAt) %></span>
        <% if (message.isUnread) { %>
          <span data-unread class="rounded bg-neutral-900 dark:bg-neutral-100 px-2 py-0.5 text-xs font-medium text-white dark:text-neutral-900">Unread</span>
        <% } %>
      </p>
      <p class="mt-2 whitespace-pre-line"><%= message.body %></p>
      <% if (message.publishedFaqId && thread.listing) { %>
        <p class="mt-2 text-sm">
          <a href="/seller/listings/<%= thread.listing.id %>/faqs#faq-<%= message.publishedFaqId %>" class="underline">Published to FAQ</a>
        </p>
      <% } %>
    </li>
  <% }); %>
</ul>

<% if (thread.mayPost) { %>
  <form method="post" action="/seller/messages/<%= thread.conversation.id %>" class="mt-6 rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 p-4">
  <%- include('views/partials/csrf-field', { csrfToken }) %>
  <%- include('views/partials/form-error', { formError: typeof replyFormError !== 'undefined' ? replyFormError : null }) %>
    <%- include('views/partials/form-field', {
      name: 'body',
      id: 'body',
      label: 'Reply',
      type: 'textarea',
      rows: 4,
      value: typeof replyBody !== 'undefined' ? replyBody : '',
      error: typeof replyError !== 'undefined' ? replyError : undefined,
      wrapperClass: '',
    }) %>
    <button type="submit" class="mt-3 rounded bg-neutral-900 dark:bg-neutral-100 px-4 py-2 text-sm font-medium text-white dark:text-neutral-900">Send</button>
  </form>
<% } %>

<% if (thread.listing) { %>
  <form
    method="post"
    action="/seller/listings/<%= thread.listing.id %>/faqs"
    class="mt-6 rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 p-4"
  >
  <%- include('views/partials/csrf-field', { csrfToken }) %>
  <%- include('views/partials/form-error', { formError: typeof faqFormError !== 'undefined' ? faqFormError : null }) %>
    <h2 class="font-semibold text-neutral-700 dark:text-neutral-300">Publish as FAQ</h2>

    <%- include('views/partials/form-field', {
      name: 'question',
      id: 'faq-question',
      label: 'Question',
      type: 'textarea',
      rows: 2,
      value: faqPrefill.question,
      error: typeof faqErrors !== 'undefined' ? faqErrors.question : undefined,
    }) %>

    <%- include('views/partials/form-field', {
      name: 'answer',
      id: 'faq-answer',
      label: 'Answer',
      type: 'textarea',
      rows: 3,
      value: faqPrefill.answer,
      error: typeof faqErrors !== 'undefined' ? faqErrors.answer : undefined,
    }) %>

    <% if (faqPrefill.sourceMessageId) { %>
      <input type="hidden" name="source_message_id" value="<%= faqPrefill.sourceMessageId %>" />
    <% } %>
    <input type="hidden" name="conversation_id" value="<%= thread.conversation.id %>" />
    <input type="hidden" name="redirect_to" value="/seller/messages/<%= thread.conversation.id %>" />

    <button type="submit" class="mt-3 rounded bg-neutral-900 dark:bg-neutral-100 px-4 py-2 text-sm font-medium text-white dark:text-neutral-900">Publish as FAQ</button>
  </form>
<% } %>
