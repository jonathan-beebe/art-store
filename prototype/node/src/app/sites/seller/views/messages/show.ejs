<div class="flex flex-wrap items-center gap-4">
  <h1 class="text-2xl font-semibold"><%= thread.topic %></h1>
  <p class="text-sm text-neutral-600">with <%= thread.counterpart %></p>
  <a href="/seller/messages" class="ml-auto text-sm underline">All messages</a>
</div>

<ul class="mt-6 space-y-3">
  <% thread.messages.forEach(function (message) { %>
    <li data-message="<%= message.id %>" class="rounded border border-neutral-300 bg-white p-4 text-sm">
      <p class="flex flex-wrap items-center gap-2 text-neutral-600">
        <span class="font-medium text-neutral-900"><%= message.senderName %></span>
        <span><%= formatDateTime(message.sentAt) %></span>
        <% if (message.isUnread) { %>
          <span data-unread class="rounded bg-neutral-900 px-2 py-0.5 text-xs font-medium text-white">Unread</span>
        <% } %>
      </p>
      <p class="mt-2 whitespace-pre-line"><%= message.body %></p>
      <% if (message.publishedFaqId && thread.listing) { %>
        <p class="mt-2 text-sm">
          <a href="/seller/listings/<%= thread.listing.id %>/faqs#faq-<%= message.publishedFaqId %>" class="underline">Published to FAQ</a>
        </p>
      <% } %>
    </li>
  <% }); %>
</ul>

<% if (thread.mayPost) { %>
  <form method="post" action="/seller/messages/<%= thread.conversation.id %>" class="mt-6 rounded border border-neutral-300 bg-white p-4">
  <%- include('views/partials/csrf-field', { csrfToken }) %>
    <label for="body" class="block text-sm font-medium text-neutral-700">Reply</label>
    <textarea id="body" name="body" rows="4" class="mt-1 block w-full rounded border border-neutral-400 px-3 py-2 text-sm"></textarea>
    <button type="submit" class="mt-3 rounded bg-neutral-900 px-4 py-2 text-sm font-medium text-white">Send</button>
  </form>
<% } %>

<% if (thread.listing) { %>
  <form
    method="post"
    action="/seller/listings/<%= thread.listing.id %>/faqs"
    class="mt-6 rounded border border-neutral-300 bg-white p-4"
  >
  <%- include('views/partials/csrf-field', { csrfToken }) %>
    <h2 class="font-semibold text-neutral-700">Publish as FAQ</h2>

    <div class="mt-2">
      <label for="faq-question" class="block text-sm font-medium text-neutral-700">Question</label>
      <textarea
        id="faq-question"
        name="question"
        rows="2"
        class="mt-1 block w-full rounded border border-neutral-400 px-3 py-2 text-sm"
      ><%= faqPrefill.question %></textarea>
    </div>

    <div class="mt-3">
      <label for="faq-answer" class="block text-sm font-medium text-neutral-700">Answer</label>
      <textarea
        id="faq-answer"
        name="answer"
        rows="3"
        class="mt-1 block w-full rounded border border-neutral-400 px-3 py-2 text-sm"
      ><%= faqPrefill.answer %></textarea>
    </div>

    <% if (faqPrefill.sourceMessageId) { %>
      <input type="hidden" name="source_message_id" value="<%= faqPrefill.sourceMessageId %>" />
    <% } %>
    <input type="hidden" name="redirect_to" value="/seller/messages/<%= thread.conversation.id %>" />

    <button type="submit" class="mt-3 rounded bg-neutral-900 px-4 py-2 text-sm font-medium text-white">Publish as FAQ</button>
  </form>
<% } %>
