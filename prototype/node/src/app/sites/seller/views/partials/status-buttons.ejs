<% statusButtons(transitions).forEach(function (button) { %>
  <form method="post" action="/seller/listings/<%= listing.id %>/status" class="inline">
  <%- include('views/partials/csrf-field', { csrfToken }) %>
    <input type="hidden" name="status" value="<%= button.status %>" />
    <button
      type="submit"
      data-status-button="<%= button.status %>"
      class="rounded border border-neutral-400 px-2 py-1 text-sm"
    ><%= button.label %></button>
  </form>
<% }); %>
