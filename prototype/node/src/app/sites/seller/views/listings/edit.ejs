<h1 class="text-2xl font-semibold">Edit <%= listing.title %></h1>

<img
  src="<%= imageSrc %>"
  alt="Current image for <%= listing.title %>"
  width="160"
  height="160"
  class="mt-4 h-40 w-40 rounded border border-neutral-300 dark:border-neutral-700 object-cover"
/>

<%- include('form', {
  action: `/seller/listings/${listing.id}`,
  submitLabel: 'Save changes',
  fields,
  errors,
  formError: typeof formError !== 'undefined' ? formError : null,
}) %>
