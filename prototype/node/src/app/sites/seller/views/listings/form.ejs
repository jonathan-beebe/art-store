<form
  method="post"
  action="<%= action %>"
  enctype="multipart/form-data"
  class="mt-4 max-w-3xl rounded border border-neutral-300 bg-white p-4"
>
  <%- include('views/partials/csrf-field', { csrfToken }) %>
  <%- include('views/partials/form-error', { formError: typeof formError !== 'undefined' ? formError : null }) %>
  <fieldset>
    <legend class="font-semibold text-neutral-700">Listing details</legend>

    <%- include('views/partials/form-field', {
      name: 'title',
      id: 'listing_title',
      label: 'Title',
      value: fields.title ?? '',
      error: errors.title,
      required: true,
      maxlength: 255,
      wrapperClass: 'mt-2',
    }) %>

    <%- include('views/partials/form-field', {
      name: 'description',
      id: 'listing_description',
      label: 'Description',
      type: 'textarea',
      value: fields.description ?? '',
      error: errors.description,
      rows: 4,
      maxlength: 5000,
    }) %>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <%- include('views/partials/form-field', {
        name: 'medium',
        id: 'listing_medium',
        label: 'Medium',
        value: fields.medium ?? '',
        error: errors.medium,
        maxlength: 255,
        wrapperClass: '',
      }) %>

      <%- include('views/partials/form-field', {
        name: 'dimensions',
        id: 'listing_dimensions',
        label: 'Dimensions',
        value: fields.dimensions ?? '',
        error: errors.dimensions,
        maxlength: 255,
        wrapperClass: '',
      }) %>

      <%- include('views/partials/form-field', {
        name: 'price',
        id: 'listing_price',
        label: 'Price (dollars)',
        value: fields.price ?? '',
        error: errors.price,
        required: true,
        inputmode: 'decimal',
        wrapperClass: '',
      }) %>

      <%- include('views/partials/form-field', {
        name: 'quantity',
        id: 'listing_quantity',
        label: 'Quantity',
        type: 'number',
        value: fields.quantity ?? '',
        error: errors.quantity,
        required: true,
        step: 1,
        min: 0,
        max: 999,
        wrapperClass: '',
      }) %>
    </div>

    <div class="mt-4">
      <label for="listing_image" class="block text-sm font-medium text-neutral-700">Image</label>
      <input
        type="file"
        name="image"
        id="listing_image"
        accept="image/*"
        aria-describedby="listing_image-hint<% if (errors.image) { %> listing_image-error<% } %>"
        <% if (errors.image) { %>aria-invalid="true"<% } %>
        class="mt-1 block w-full rounded border border-neutral-400 px-3 py-2 text-sm"
      />
      <p id="listing_image-hint" class="mt-1 text-sm text-neutral-600">
        A PNG, JPEG, GIF, or WebP file up to 5 MB. Artwork drawn from the title stands in until you upload one.
      </p>
      <%- include('views/partials/field-error', { field: 'listing_image', message: errors.image }) %>
    </div>
  </fieldset>

  <div class="mt-6 flex items-center gap-3">
    <button type="submit" class="rounded bg-neutral-900 px-4 py-2 text-sm font-medium text-white"><%= submitLabel %></button>
    <a href="/seller/listings" class="text-sm underline">Cancel</a>
  </div>
</form>
