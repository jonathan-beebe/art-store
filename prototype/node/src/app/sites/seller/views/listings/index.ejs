<div class="flex flex-wrap items-center gap-4">
  <h1 class="text-2xl font-semibold">Listings</h1>
  <a href="/seller/listings/new" class="ml-auto rounded bg-neutral-900 px-4 py-2 text-sm font-medium text-white">New listing</a>
</div>

<% if (rows.length === 0) { %>
  <p class="mt-4 rounded border border-neutral-300 bg-white p-4 text-neutral-600">No listings yet. Start with a new one.</p>
<% } else { %>
  <div class="mt-4 overflow-x-auto rounded border border-neutral-300 bg-white">
    <table class="w-full text-left text-sm">
      <caption class="sr-only">Your listings, newest first</caption>
      <thead class="border-b border-neutral-300 bg-neutral-50">
        <tr>
          <th scope="col" class="px-4 py-2 font-semibold">Listing</th>
          <th scope="col" class="px-4 py-2 font-semibold">Status</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Price</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Qty</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Views</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Favorites</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Cart adds</th>
          <th scope="col" class="px-4 py-2 font-semibold">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-200">
        <% rows.forEach(function (row) { %>
          <tr data-listing="<%= row.listing.id %>">
            <th scope="row" class="px-4 py-3 font-normal">
              <span class="flex items-center gap-3">
                <img src="<%= row.imageSrc %>" alt="" width="48" height="48" class="h-12 w-12 rounded object-cover" />
                <a href="/seller/listings/<%= row.listing.id %>" class="font-medium underline"><%= row.listing.title %></a>
              </span>
            </th>
            <td data-cell="status" class="px-4 py-3"><%= statusLabel(row.listing.status) %></td>
            <td class="px-4 py-3 text-right tabular-nums"><%= formatCents(row.listing.priceCents) %></td>
            <td class="px-4 py-3 text-right tabular-nums"><%= row.listing.quantity %></td>
            <td data-activity="views" class="px-4 py-3 text-right tabular-nums"><%= row.activity.views %></td>
            <td data-activity="favorites" class="px-4 py-3 text-right tabular-nums"><%= row.activity.favorites %></td>
            <td data-activity="cart_adds" class="px-4 py-3 text-right tabular-nums"><%= row.activity.cartAdds %></td>
            <td class="px-4 py-3">
              <span class="flex flex-wrap items-center gap-2">
                <a href="/seller/listings/<%= row.listing.id %>/edit" class="rounded border border-neutral-400 px-2 py-1">Edit</a>
                <%- include('../partials/status-buttons', { listing: row.listing, transitions: row.transitions, statusLabel }) %>
              </span>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>
