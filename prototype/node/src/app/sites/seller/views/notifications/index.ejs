<h1 class="text-2xl font-semibold">Notifications</h1>

<% if (notifications.length === 0) { %>
  <p class="mt-4 rounded border border-neutral-300 bg-white p-4 text-neutral-600">Nothing yet.</p>
<% } else { %>
  <ul class="mt-4 divide-y divide-neutral-200 rounded border border-neutral-300 bg-white">
    <% notifications.forEach(function (notification) { %>
      <li data-notification="<%= notification.id %>" class="flex flex-wrap items-start gap-4 p-4">
        <div>
          <p class="font-medium">
            <%= notification.subject %>
            <% if (!notification.readAt) { %>
              <span data-unread class="ml-1 rounded bg-neutral-900 px-2 py-0.5 text-xs font-medium text-white">Unread</span>
            <% } %>
          </p>
          <p class="mt-1 text-sm text-neutral-600"><%= notification.body %></p>
          <p class="mt-1 text-sm text-neutral-500"><%= formatDateTime(notification.createdAt) %></p>
          <% if (notification.url) { %>
            <p class="mt-1"><a href="<%= notification.url %>" class="text-sm underline">Open</a></p>
          <% } %>
        </div>

        <% if (!notification.readAt) { %>
          <form method="post" action="/seller/notifications/<%= notification.id %>/read" class="ml-auto">
            <button type="submit" class="rounded border border-neutral-400 px-3 py-1 text-sm">Mark as read</button>
          </form>
        <% } %>
      </li>
    <% }); %>
  </ul>
<% } %>
