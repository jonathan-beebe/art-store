<h1 class="text-2xl font-semibold">Dashboard</h1>

<section aria-labelledby="listings-heading" class="mt-6">
  <div class="flex flex-wrap items-center gap-4">
    <h2 id="listings-heading" class="font-semibold text-neutral-700">Listings</h2>
    <a href="/seller/listings" class="ml-auto text-sm underline">All listings</a>
  </div>

  <dl class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <% tally.forEach(function (row) { %>
      <div class="rounded border border-neutral-300 bg-white p-4">
        <dt class="text-sm text-neutral-600"><%= statusLabel(row.status) %></dt>
        <dd data-stat="<%= row.status %>" class="mt-1 text-2xl font-semibold tabular-nums"><%= row.count %></dd>
      </div>
    <% }); %>
  </dl>
</section>

<section aria-labelledby="work-heading" class="mt-6">
  <h2 id="work-heading" class="font-semibold text-neutral-700">Money and work</h2>

  <dl class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="rounded border border-neutral-300 bg-white p-4">
      <dt class="text-sm text-neutral-600">Awaiting shipment</dt>
      <dd data-stat="awaiting_shipment" class="mt-1 text-2xl font-semibold tabular-nums"><%= awaitingShipment %></dd>
    </div>
    <div class="rounded border border-neutral-300 bg-white p-4">
      <dt class="text-sm text-neutral-600">Held in escrow</dt>
      <dd data-stat="held" class="mt-1 text-2xl font-semibold tabular-nums"><%= formatCents(balance.heldCents) %></dd>
    </div>
    <div class="rounded border border-neutral-300 bg-white p-4">
      <dt class="text-sm text-neutral-600">Available</dt>
      <dd data-stat="available" class="mt-1 text-2xl font-semibold tabular-nums"><%= formatCents(balance.availableCents) %></dd>
    </div>
    <div class="rounded border border-neutral-300 bg-white p-4">
      <dt class="text-sm text-neutral-600">Unread notifications</dt>
      <dd data-stat="unread_notifications" class="mt-1 text-2xl font-semibold tabular-nums"><%= unreadCount %></dd>
    </div>
  </dl>
</section>

<section aria-labelledby="notifications-heading" class="mt-6">
  <div class="flex flex-wrap items-center gap-4">
    <h2 id="notifications-heading" class="font-semibold text-neutral-700">Recent notifications</h2>
    <a href="/seller/notifications" class="ml-auto text-sm underline">All notifications</a>
  </div>

  <% if (recentNotifications.length === 0) { %>
    <p class="mt-2 rounded border border-neutral-300 bg-white p-4 text-neutral-600">Nothing yet.</p>
  <% } else { %>
    <ul class="mt-2 divide-y divide-neutral-200 rounded border border-neutral-300 bg-white">
      <% recentNotifications.forEach(function (notification) { %>
        <li data-recent-notification class="p-4">
          <p class="font-medium"><%= notification.subject %></p>
          <p class="mt-1 text-sm text-neutral-600"><%= notification.body %></p>
          <p class="mt-1 text-sm text-neutral-500"><%= formatDateTime(notification.createdAt) %></p>
        </li>
      <% }); %>
    </ul>
  <% } %>
</section>
