<div class="flex flex-wrap items-center gap-4">
  <h1 class="text-2xl font-semibold">Order <%= fulfillment.orderId %></h1>
  <p data-cell="status" class="text-sm text-neutral-600"><%= statusLabel(fulfillment.status) %></p>
  <div class="ml-auto flex items-center gap-4">
    <form method="post" action="/seller/orders/<%= fulfillment.id %>/messages">
  <%- include('views/partials/csrf-field', { csrfToken }) %>
      <button type="submit" class="rounded border border-neutral-400 px-3 py-2 text-sm">Message the customer</button>
    </form>
    <a href="/seller/orders" class="text-sm underline">All orders</a>
  </div>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <section aria-labelledby="address-heading">
    <h2 id="address-heading" class="font-semibold text-neutral-700">Ship to</h2>

    <address data-shipping-address class="mt-2 rounded border border-neutral-300 bg-white p-4 text-sm not-italic">
      <%= order.shippingName %><br />
      <%= order.shippingLine1 %><br />
      <% if (order.shippingLine2) { %>
        <%= order.shippingLine2 %><br />
      <% } %>
      <%= order.shippingCity %>, <%= order.shippingRegion %><br />
      <%= order.shippingPostalCode %><br />
      <%= order.shippingCountry %>
    </address>
  </section>

  <section aria-labelledby="items-heading">
    <h2 id="items-heading" class="font-semibold text-neutral-700">Your items</h2>

    <div class="mt-2 overflow-x-auto rounded border border-neutral-300 bg-white">
      <table class="w-full text-left text-sm">
        <caption class="sr-only">Items in this order that belong to you</caption>
        <thead class="border-b border-neutral-300 bg-neutral-50">
          <tr>
            <th scope="col" class="px-4 py-2 font-semibold">Item</th>
            <th scope="col" class="px-4 py-2 text-right font-semibold">Qty</th>
            <th scope="col" class="px-4 py-2 text-right font-semibold">Unit price</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-200">
          <% items.forEach(function (item) { %>
            <tr data-item="<%= item.id %>">
              <th scope="row" class="px-4 py-2 font-normal"><%= item.title %></th>
              <td class="px-4 py-2 text-right tabular-nums"><%= item.quantity %></td>
              <td class="px-4 py-2 text-right tabular-nums"><%= formatCents(item.unitPriceCents) %></td>
            </tr>
          <% }); %>
        </tbody>
        <tfoot class="border-t border-neutral-300">
          <tr>
            <th scope="row" class="px-4 py-2 text-left font-semibold">Net to you</th>
            <td colspan="2" data-cell="net" class="px-4 py-2 text-right font-semibold tabular-nums"><%= formatCents(fulfillment.netCents) %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </section>
</div>

<section aria-labelledby="shipment-heading" class="mt-6 max-w-xl">
  <h2 id="shipment-heading" class="font-semibold text-neutral-700">Shipment</h2>

  <% if (canShip) { %>
    <form method="post" action="/seller/orders/<%= fulfillment.id %>/ship" class="mt-2 rounded border border-neutral-300 bg-white p-4">
  <%- include('views/partials/csrf-field', { csrfToken }) %>
      <fieldset>
        <legend class="text-sm font-medium text-neutral-700">Mark shipped</legend>

        <div class="mt-2">
          <label for="carrier" class="block text-sm font-medium text-neutral-700">Carrier</label>
          <input
            type="text"
            name="carrier"
            id="carrier"
            required
            maxlength="255"
            class="mt-1 block w-full rounded border border-neutral-400 px-3 py-2 text-sm"
          />
        </div>

        <div class="mt-4">
          <label for="tracking_number" class="block text-sm font-medium text-neutral-700">Tracking number</label>
          <input
            type="text"
            name="tracking_number"
            id="tracking_number"
            required
            maxlength="255"
            class="mt-1 block w-full rounded border border-neutral-400 px-3 py-2 text-sm"
          />
        </div>
      </fieldset>

      <button type="submit" class="mt-4 rounded bg-neutral-900 px-4 py-2 text-sm font-medium text-white">Mark shipped</button>
    </form>
  <% } else if (refund) { %>
    <dl data-refund="<%= refund.id %>" class="mt-2 rounded border border-neutral-300 bg-white p-4 text-sm">
      <dt class="text-neutral-600">Reason</dt>
      <dd data-cell="reason" class="mt-1"><%= refund.reason %></dd>
      <dt class="mt-3 text-neutral-600">Refunded to the customer</dt>
      <dd data-cell="amount" class="mt-1 tabular-nums"><%= formatCents(refund.amountCents) %></dd>
    </dl>
  <% } else { %>
    <dl data-shipment class="mt-2 rounded border border-neutral-300 bg-white p-4 text-sm">
      <dt class="text-neutral-600">Carrier</dt>
      <dd data-cell="carrier" class="mt-1"><%= fulfillment.carrier %></dd>
      <dt class="mt-3 text-neutral-600">Tracking number</dt>
      <dd data-cell="tracking_number" class="mt-1"><%= fulfillment.trackingNumber %></dd>
      <% if (fulfillment.shippedAt) { %>
        <dt class="mt-3 text-neutral-600">Shipped</dt>
        <dd data-cell="shipped_at" class="mt-1"><%= formatDateTime(fulfillment.shippedAt) %></dd>
      <% } %>
      <% if (fulfillment.deliveredAt) { %>
        <dt class="mt-3 text-neutral-600">Delivered</dt>
        <dd data-cell="delivered_at" class="mt-1"><%= formatDateTime(fulfillment.deliveredAt) %></dd>
      <% } %>
    </dl>
  <% } %>
</section>

<% if (canDecline) { %>
<section aria-labelledby="decline-heading" class="mt-6 max-w-xl">
  <h2 id="decline-heading" class="font-semibold text-neutral-700">Decline</h2>

  <form method="post" action="/seller/orders/<%= fulfillment.id %>/decline" class="mt-2 rounded border border-neutral-300 bg-white p-4">
  <%- include('views/partials/csrf-field', { csrfToken }) %>
    <p class="text-sm text-neutral-600">
      Declining refunds <%= formatCents(fulfillment.subtotalCents) %> to the customer and puts
      your pieces back on the storefront.
    </p>

    <div class="mt-4">
      <label for="decline_reason" class="block text-sm font-medium text-neutral-700">Reason</label>
      <textarea
        name="reason"
        id="decline_reason"
        rows="3"
        required
        maxlength="<%= reasonMaxLength %>"
        class="mt-1 block w-full rounded border border-neutral-400 px-3 py-2 text-sm"
      ></textarea>
    </div>

    <button type="submit" class="mt-4 rounded border border-red-700 px-4 py-2 text-sm font-medium text-red-700">Decline this order</button>
  </form>
</section>
<% } %>
