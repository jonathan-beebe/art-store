<h1 class="text-2xl font-semibold">Earnings</h1>

<section aria-labelledby="balances-heading" class="mt-6">
  <h2 id="balances-heading" class="font-semibold text-neutral-700">Balances</h2>

  <dl class="mt-2 grid grid-cols-1 gap-3 sm:grid-cols-3">
    <div class="rounded border border-neutral-300 bg-white p-4">
      <dt class="text-sm text-neutral-600">Held in escrow</dt>
      <dd data-stat="held" class="mt-1 text-2xl font-semibold tabular-nums"><%= formatCents(balance.heldCents) %></dd>
    </div>
    <div class="rounded border border-neutral-300 bg-white p-4">
      <dt class="text-sm text-neutral-600">Available</dt>
      <dd data-stat="available" class="mt-1 text-2xl font-semibold tabular-nums"><%= formatCents(balance.availableCents) %></dd>
    </div>
    <div class="rounded border border-neutral-300 bg-white p-4">
      <dt class="text-sm text-neutral-600">Paid out</dt>
      <dd data-stat="paid_out" class="mt-1 text-2xl font-semibold tabular-nums"><%= formatCents(balance.paidOutCents) %></dd>
    </div>
  </dl>
</section>

<section aria-labelledby="sales-heading" class="mt-6">
  <h2 id="sales-heading" class="font-semibold text-neutral-700">Sold goods</h2>

  <% if (fulfillments.length === 0) { %>
    <p class="mt-2 rounded border border-neutral-300 bg-white p-4 text-neutral-600">No sales yet.</p>
  <% } else { %>
    <div class="mt-2 overflow-x-auto rounded border border-neutral-300 bg-white">
      <table class="w-full text-left text-sm">
        <caption class="sr-only">Every sale, newest first</caption>
        <thead class="border-b border-neutral-300 bg-neutral-50">
          <tr>
            <th scope="col" class="px-4 py-2 font-semibold">Date</th>
            <th scope="col" class="px-4 py-2 font-semibold">Order</th>
            <th scope="col" class="px-4 py-2 font-semibold">Items</th>
            <th scope="col" class="px-4 py-2 text-right font-semibold">Subtotal</th>
            <th scope="col" class="px-4 py-2 text-right font-semibold">Fee</th>
            <th scope="col" class="px-4 py-2 text-right font-semibold">Net</th>
            <th scope="col" class="px-4 py-2 font-semibold">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-200">
          <% fulfillments.forEach(function (fulfillment) { %>
            <tr data-fulfillment="<%= fulfillment.id %>">
              <td class="px-4 py-2"><%= formatDate(fulfillment.placedAt) %></td>
              <th scope="row" class="px-4 py-2 font-normal">
                <a href="/seller/orders/<%= fulfillment.id %>" class="underline">#<%= fulfillment.orderId %></a>
              </th>
              <td class="px-4 py-2"><%= (itemTitles.get(fulfillment.orderId) || []).join(', ') %></td>
              <td data-cell="subtotal" class="px-4 py-2 text-right tabular-nums"><%= formatCents(fulfillment.subtotalCents) %></td>
              <td data-cell="fee" class="px-4 py-2 text-right tabular-nums"><%= formatCents(fulfillment.feeCents) %></td>
              <td data-cell="net" class="px-4 py-2 text-right tabular-nums"><%= formatCents(fulfillment.netCents) %></td>
              <td data-cell="status" class="px-4 py-2"><%= statusLabel(fulfillment.status) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section aria-labelledby="payouts-heading" class="mt-6">
  <h2 id="payouts-heading" class="font-semibold text-neutral-700">Payouts</h2>

  <% if (payouts.length === 0) { %>
    <p class="mt-2 rounded border border-neutral-300 bg-white p-4 text-neutral-600">No payouts yet.</p>
  <% } else { %>
    <div class="mt-2 overflow-x-auto rounded border border-neutral-300 bg-white">
      <table class="w-full text-left text-sm">
        <caption class="sr-only">Weekly payouts, newest first</caption>
        <thead class="border-b border-neutral-300 bg-neutral-50">
          <tr>
            <th scope="col" class="px-4 py-2 font-semibold">Period</th>
            <th scope="col" class="px-4 py-2 text-right font-semibold">Amount</th>
            <th scope="col" class="px-4 py-2 font-semibold">Paid</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-200">
          <% payouts.forEach(function (payout) { %>
            <tr data-payout="<%= payout.id %>">
              <th scope="row" class="px-4 py-2 font-normal"><%= payout.periodStart %> to <%= payout.periodEnd %></th>
              <td data-cell="amount" class="px-4 py-2 text-right tabular-nums"><%= formatCents(payout.amountCents) %></td>
              <td class="px-4 py-2"><%= formatDate(payout.paidAt) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
