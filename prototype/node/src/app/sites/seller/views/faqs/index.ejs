<div class="flex flex-wrap items-center gap-4">
  <h1 class="text-2xl font-semibold">Questions &amp; answers</h1>
  <p class="text-sm text-neutral-600"><%= listing.title %></p>
  <a href="/seller/listings/<%= listing.id %>" class="ml-auto text-sm underline">Back to listing</a>
</div>

<% if (faqs.length === 0) { %>
  <p class="mt-4 rounded border border-neutral-300 bg-white p-4 text-neutral-600">Nothing published yet.</p>
<% } else { %>
  <ul class="mt-4 space-y-4">
    <% faqs.forEach(function (faq) { %>
      <li data-faq="<%= faq.id %>" class="rounded border border-neutral-300 bg-white p-4">
        <form method="post" action="/seller/listings/<%= listing.id %>/faqs/<%= faq.id %>">
          <div>
            <label for="faq-<%= faq.id %>-question" class="block text-sm font-medium text-neutral-700">Question</label>
            <textarea
              id="faq-<%= faq.id %>-question"
              name="question"
              rows="2"
              class="mt-1 block w-full rounded border border-neutral-400 px-3 py-2 text-sm"
            ><%= faq.question %></textarea>
          </div>

          <div class="mt-3">
            <label for="faq-<%= faq.id %>-answer" class="block text-sm font-medium text-neutral-700">Answer</label>
            <textarea
              id="faq-<%= faq.id %>-answer"
              name="answer"
              rows="3"
              class="mt-1 block w-full rounded border border-neutral-400 px-3 py-2 text-sm"
            ><%= faq.answer %></textarea>
          </div>

          <button type="submit" class="mt-3 rounded border border-neutral-400 px-3 py-1 text-sm">Save</button>
        </form>

        <form method="post" action="/seller/listings/<%= listing.id %>/faqs/<%= faq.id %>/unpublish" class="mt-2">
          <button type="submit" class="rounded border border-neutral-400 px-3 py-1 text-sm">Unpublish</button>
        </form>
      </li>
    <% }); %>
  </ul>
<% } %>

<section class="mt-6 rounded border border-neutral-300 bg-white p-4">
  <h2 class="font-semibold text-neutral-700">Publish a new FAQ</h2>

  <form method="post" action="/seller/listings/<%= listing.id %>/faqs" class="mt-2">
    <div>
      <label for="new-faq-question" class="block text-sm font-medium text-neutral-700">Question</label>
      <textarea
        id="new-faq-question"
        name="question"
        rows="2"
        class="mt-1 block w-full rounded border border-neutral-400 px-3 py-2 text-sm"
      ></textarea>
    </div>

    <div class="mt-3">
      <label for="new-faq-answer" class="block text-sm font-medium text-neutral-700">Answer</label>
      <textarea
        id="new-faq-answer"
        name="answer"
        rows="3"
        class="mt-1 block w-full rounded border border-neutral-400 px-3 py-2 text-sm"
      ></textarea>
    </div>

    <button type="submit" class="mt-3 rounded bg-neutral-900 px-4 py-2 text-sm font-medium text-white">Publish</button>
  </form>
</section>
