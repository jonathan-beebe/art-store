<%- include('views/partials/head', { title, titleSuffix: 'Seller portal' }) %>
  <body class="supports-dark min-h-screen bg-neutral-100 dark:bg-neutral-950 text-neutral-900 dark:text-neutral-100 antialiased">
    <%- include('views/partials/debug-alert', { flash, showsDebugMagicLinks }) %>
    <%- include('views/partials/flash', { flash }) %>
    <header class="border-b border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900">
      <nav class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3 text-sm">
        <a href="/seller" class="font-semibold">Seller portal</a>
        <% if (identity.seller) { %>
        <ul class="flex gap-4 text-neutral-600 dark:text-neutral-400">
          <li><a href="/seller/listings" class="hover:text-neutral-900 dark:hover:text-neutral-100">Listings</a></li>
          <li><a href="/seller/orders" class="hover:text-neutral-900 dark:hover:text-neutral-100">Orders</a></li>
          <li>
            <a href="/seller/messages" class="hover:text-neutral-900 dark:hover:text-neutral-100">Messages<%- include('views/partials/unread-badge', {
              classes: 'ml-1 rounded bg-neutral-900 dark:bg-neutral-100 px-1.5 py-0.5 text-xs font-medium text-white dark:text-neutral-900 empty:hidden',
              unreadMessageCount,
            }) %></a>
          </li>
          <li><a href="/seller/earnings" class="hover:text-neutral-900 dark:hover:text-neutral-100">Earnings</a></li>
          <li><a href="/seller/notifications" class="hover:text-neutral-900 dark:hover:text-neutral-100">Notifications</a></li>
          <li><a href="/seller/support" class="hover:text-neutral-900 dark:hover:text-neutral-100">Support</a></li>
        </ul>
        <% } %>
        <ul class="ml-auto flex gap-4 text-neutral-600 dark:text-neutral-400">
          <li><a href="/" class="hover:text-neutral-900 dark:hover:text-neutral-100">Storefront</a></li>
          <% if (identity.seller) { %>
          <li><a href="/seller/account" class="hover:text-neutral-900 dark:hover:text-neutral-100">Account</a></li>
          <li>
            <form method="post" action="/seller/logout">
  <%- include('views/partials/csrf-field', { csrfToken }) %>
              <button type="submit" class="cursor-pointer hover:text-neutral-900 dark:hover:text-neutral-100">Sign out</button>
            </form>
          </li>
          <% } else { %>
          <li><a href="/seller/login" class="hover:text-neutral-900 dark:hover:text-neutral-100">Sign in</a></li>
          <% } %>
        </ul>
      </nav>
    </header>
    <%# the page's already-escaped markup %>
    <main class="mx-auto max-w-6xl px-4 py-8"><%- body %></main>
    <script defer src="<%= assets['app.js'] %>"></script>
  </body>
</html>
