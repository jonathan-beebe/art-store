<ol class="mt-4 space-y-3">
  <% lines.forEach(function (line) { %>
    <li data-line="<%= line.id %>" class="rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 p-3">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <span data-cell="msg" class="font-medium"><%= line.msg ?? '—' %></span>
        <span data-cell="level" class="rounded bg-neutral-100 dark:bg-neutral-800 px-1.5 py-0.5 text-xs"><%= line.level ?? '—' %></span>
        <span data-cell="event" class="text-neutral-600 dark:text-neutral-400">
          <%= line.event === null ? '—' : line.event %><% if (line.phase !== null) { %> · <%= line.phase %><% } %>
        </span>
        <span data-cell="ts" class="ml-auto tabular-nums text-neutral-500"><%= line.ts %></span>
        <% if (line.durationMs !== null) { %>
          <span data-cell="duration" class="tabular-nums text-neutral-500"><%= line.durationMs %> ms</span>
        <% } %>
      </div>
      <% if (line.data !== null) { %>
        <details<%= openDetails ? ' open' : '' %> class="mt-2">
          <summary class="cursor-pointer text-neutral-500">data</summary>
          <pre class="mt-1 overflow-x-auto rounded bg-neutral-50 dark:bg-neutral-800/50 p-2 text-xs"><%- linkedIds(formatJson(line.data)) %></pre>
        </details>
      <% } %>
      <% if (line.error !== null) { %>
        <details<%= openDetails ? ' open' : '' %> class="mt-2">
          <summary class="cursor-pointer text-neutral-500">error</summary>
          <pre class="mt-1 overflow-x-auto rounded bg-neutral-50 dark:bg-neutral-800/50 p-2 text-xs"><%- linkedIds(formatJson(line.error)) %></pre>
        </details>
      <% } %>
    </li>
  <% }) %>
</ol>
