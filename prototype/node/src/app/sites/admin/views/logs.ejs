<div class="flex flex-wrap items-center gap-4">
  <h1 class="text-lg font-semibold">Logs</h1>
</div>

<% if (!storeAvailable) { %>
  <%- include('sites/admin/views/partials/empty', { message: 'The log store is unavailable — LOG_DATABASE_FILE is off or the store failed to open. Every line still goes to stdout.' }) %>
<% } else { %>
  <form method="get" action="/admin/logs" class="mt-4 flex flex-wrap items-end gap-3 rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 p-3">
    <div>
      <label for="level" class="block text-neutral-600 dark:text-neutral-400">Level</label>
      <select id="level" name="level" class="mt-1 rounded border border-neutral-400 dark:border-neutral-600 px-2 py-1">
        <option value="">All</option>
        <% levels.forEach(function (level) { %>
          <option value="<%= level %>" <%= filters.level === level ? 'selected' : '' %>><%= level %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label for="phase" class="block text-neutral-600 dark:text-neutral-400">Phase</label>
      <select id="phase" name="phase" class="mt-1 rounded border border-neutral-400 dark:border-neutral-600 px-2 py-1">
        <option value="">All</option>
        <% phases.forEach(function (phase) { %>
          <option value="<%= phase %>" <%= filters.phase === phase ? 'selected' : '' %>><%= phase %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label for="event" class="block text-neutral-600 dark:text-neutral-400">Event</label>
      <select id="event" name="event" class="mt-1 rounded border border-neutral-400 dark:border-neutral-600 px-2 py-1">
        <option value="">All</option>
        <% events.forEach(function (event) { %>
          <option value="<%= event %>" <%= filters.event === event ? 'selected' : '' %>><%= event %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label for="request" class="block text-neutral-600 dark:text-neutral-400">Request id</label>
      <input id="request" name="request" type="text" value="<%= filters.request ?? '' %>" class="mt-1 w-48 rounded border border-neutral-400 dark:border-neutral-600 px-2 py-1">
    </div>
    <div>
      <label for="txn" class="block text-neutral-600 dark:text-neutral-400">Transaction id</label>
      <input id="txn" name="txn" type="text" value="<%= filters.txn ?? '' %>" class="mt-1 w-48 rounded border border-neutral-400 dark:border-neutral-600 px-2 py-1">
    </div>
    <div>
      <label for="session" class="block text-neutral-600 dark:text-neutral-400">Session id</label>
      <input id="session" name="session" type="text" value="<%= filters.session ?? '' %>" class="mt-1 w-48 rounded border border-neutral-400 dark:border-neutral-600 px-2 py-1">
    </div>
    <div>
      <label for="actor" class="block text-neutral-600 dark:text-neutral-400">Actor id</label>
      <input id="actor" name="actor" type="text" value="<%= filters.actor ?? '' %>" class="mt-1 w-48 rounded border border-neutral-400 dark:border-neutral-600 px-2 py-1">
    </div>
    <div>
      <label for="msg" class="block text-neutral-600 dark:text-neutral-400">Message contains</label>
      <input id="msg" name="msg" type="text" value="<%= filters.msg ?? '' %>" class="mt-1 w-48 rounded border border-neutral-400 dark:border-neutral-600 px-2 py-1">
    </div>
    <div>
      <label for="from" class="block text-neutral-600 dark:text-neutral-400">From (UTC instant)</label>
      <input id="from" name="from" type="text" placeholder="2026-08-24T00:00:00Z" value="<%= filters.from ?? '' %>" class="mt-1 w-48 rounded border border-neutral-400 dark:border-neutral-600 px-2 py-1">
    </div>
    <div>
      <label for="to" class="block text-neutral-600 dark:text-neutral-400">To (UTC instant)</label>
      <input id="to" name="to" type="text" placeholder="2026-08-25T00:00:00Z" value="<%= filters.to ?? '' %>" class="mt-1 w-48 rounded border border-neutral-400 dark:border-neutral-600 px-2 py-1">
    </div>
    <div>
      <label for="key" class="block text-neutral-600 dark:text-neutral-400">Attribute key</label>
      <input id="key" name="key" type="text" placeholder="data.order_id" value="<%= filters.key ?? '' %>" class="mt-1 w-48 rounded border border-neutral-400 dark:border-neutral-600 px-2 py-1">
    </div>
    <div>
      <label for="value" class="block text-neutral-600 dark:text-neutral-400">Attribute value</label>
      <input id="value" name="value" type="text" value="<%= filters.value ?? '' %>" class="mt-1 w-48 rounded border border-neutral-400 dark:border-neutral-600 px-2 py-1">
    </div>
    <button type="submit" class="rounded bg-neutral-900 dark:bg-neutral-100 px-4 py-2 font-medium text-white dark:text-neutral-900">Filter</button>
  </form>

  <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <% tiles.forEach(function (tile) { %>
      <a href="<%= tile.href %>" data-stat="level-<%= tile.level %>" class="rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 px-3 py-2 hover:border-neutral-500 dark:hover:border-neutral-500">
        <span class="block text-neutral-500"><%= tile.label %></span>
        <span data-count class="mt-1 block text-lg font-semibold tabular-nums"><%= tile.count %></span>
      </a>
    <% }) %>
  </div>

  <% if (lines.length === 0) { %>
    <%- include('sites/admin/views/partials/empty', { message: 'No log lines match these filters.' }) %>
  <% } else { %>
    <div class="mt-4 overflow-x-auto rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900">
      <table class="w-full text-left">
        <caption class="sr-only">Log lines, newest first</caption>
        <thead class="border-b border-neutral-300 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800/50">
          <tr>
            <th scope="col" class="px-4 py-2 font-semibold">At</th>
            <th scope="col" class="px-4 py-2 font-semibold">Level</th>
            <th scope="col" class="px-4 py-2 font-semibold">Event</th>
            <th scope="col" class="px-4 py-2 font-semibold">Message</th>
            <th scope="col" class="px-4 py-2 font-semibold">Request</th>
            <th scope="col" class="px-4 py-2 font-semibold">Actor</th>
            <th scope="col" class="px-4 py-2 text-right font-semibold">ms</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-200 dark:divide-neutral-800">
          <% lines.forEach(function (line) { %>
            <tr data-line="<%= line.id %>">
              <td data-cell="ts" class="px-4 py-2 whitespace-nowrap tabular-nums"><%= line.ts %></td>
              <td data-cell="level" class="px-4 py-2"><%= line.level ?? '—' %></td>
              <td data-cell="event" class="px-4 py-2 whitespace-nowrap">
                <%= line.event === null ? '—' : line.event %><% if (line.phase !== null) { %> · <%= line.phase %><% } %>
              </td>
              <td data-cell="msg" class="px-4 py-2">
                <%= line.msg ?? '—' %>
                <% if (line.data !== null) { %>
                  <details class="mt-1">
                    <summary class="cursor-pointer text-neutral-500">data</summary>
                    <pre class="mt-1 overflow-x-auto rounded bg-neutral-50 dark:bg-neutral-800/50 p-2 text-xs"><%- linkedIds(formatJson(line.data)) %></pre>
                  </details>
                <% } %>
                <% if (line.error !== null) { %>
                  <details class="mt-1">
                    <summary class="cursor-pointer text-neutral-500">error</summary>
                    <pre class="mt-1 overflow-x-auto rounded bg-neutral-50 dark:bg-neutral-800/50 p-2 text-xs"><%- linkedIds(formatJson(line.error)) %></pre>
                  </details>
                <% } %>
              </td>
              <td data-cell="request" class="px-4 py-2 whitespace-nowrap">
                <% if (line.requestId === null) { %>—<% } else { %>
                  <a href="/admin/logs/requests/<%= encodeURIComponent(line.requestId) %>" class="underline"><%= line.requestId %></a>
                <% } %>
              </td>
              <td data-cell="actor" class="px-4 py-2 whitespace-nowrap">
                <% if (line.actorId === null) { %><%= line.actorType ?? '—' %><% } else { %>
                  <%= line.actorType ?? '' %> <%- linkedIds(line.actorId) %>
                <% } %>
              </td>
              <td data-cell="duration" class="px-4 py-2 text-right tabular-nums"><%= line.durationMs ?? '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('views/partials/pager', { page, basePath: '/admin/logs', query: filterQuery, param: 'page' }) %>
  <% } %>
<% } %>
