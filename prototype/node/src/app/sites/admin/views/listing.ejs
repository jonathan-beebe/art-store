<div data-listing="<%= listing.id %>">
  <div class="flex flex-wrap items-center gap-4">
    <h1 class="text-lg font-semibold"><%= listing.title %></h1>
    <p class="text-neutral-600 dark:text-neutral-400">
      <span data-cell="status"><%= statusLabel(listing.status) %></span>
      &middot; <%= formatCents(listing.priceCents) %>
      &middot; <%= listing.quantity %> in stock
      &middot; seller <%= seller.name %>
      &middot; <span data-cell="on-storefront"><%= isOnStorefront ? 'On storefront' : 'Off storefront' %></span>
    </p>
  </div>

  <section aria-labelledby="moderation-heading" class="mt-6">
    <h2 id="moderation-heading" class="font-semibold text-neutral-700 dark:text-neutral-300">Moderation</h2>

    <% if (activeRemoval) { %>
      <div data-removal="<%= activeRemoval.kind %>" class="mt-2 rounded border border-amber-300 dark:border-amber-900 bg-amber-50 dark:bg-amber-950/40 p-4">
        <p class="font-medium">
          <%= statusLabel(activeRemoval.kind) %> removal since <%= formatMoment(activeRemoval.createdAt) %>
        </p>
        <p class="mt-1 text-neutral-700 dark:text-neutral-300"><%= activeRemoval.reason %></p>

        <% if (activeRemoval.canLift) { %>
          <form method="post" action="/admin/listings/<%= listing.id %>/removals/lift" class="mt-3">
  <%- include('views/partials/csrf-field', { csrfToken }) %>
            <input type="hidden" name="redirect_to" value="/admin/listings/<%= listing.id %>">
            <button type="submit" class="rounded bg-neutral-900 dark:bg-neutral-100 px-4 py-2 font-medium text-white dark:text-neutral-900">Lift removal</button>
          </form>
        <% } else { %>
          <p class="mt-3 text-neutral-600 dark:text-neutral-400">A permanent removal cannot be lifted.</p>
        <% } %>
      </div>
    <% } else { %>
      <form method="post" action="/admin/listings/<%= listing.id %>/removals" class="mt-2 flex flex-col gap-3 rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 p-4">
  <%- include('views/partials/csrf-field', { csrfToken }) %>
        <input type="hidden" name="redirect_to" value="/admin/listings/<%= listing.id %>">
        <div>
          <label for="kind" class="block text-neutral-600 dark:text-neutral-400">Kind</label>
          <select id="kind" name="kind" class="mt-1 rounded border border-neutral-400 dark:border-neutral-600 px-2 py-1">
            <% removalKinds.forEach(function (kind) { %>
              <option value="<%= kind %>"><%= statusLabel(kind) %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label for="reason" class="block text-neutral-600 dark:text-neutral-400">Reason</label>
          <textarea id="reason" name="reason" required class="mt-1 w-full rounded border border-neutral-400 dark:border-neutral-600 px-2 py-1"></textarea>
        </div>
        <button type="submit" class="self-start rounded bg-neutral-900 dark:bg-neutral-100 px-4 py-2 font-medium text-white dark:text-neutral-900">Remove listing</button>
      </form>
    <% } %>
  </section>

  <section aria-labelledby="history-heading" class="mt-6">
    <h2 id="history-heading" class="font-semibold text-neutral-700 dark:text-neutral-300">Removal history</h2>

    <% if (removals.length === 0) { %>
      <%- include('sites/admin/views/partials/empty', { message: 'No removals on record.' }) %>
    <% } else { %>
      <div class="mt-2 overflow-x-auto rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900">
        <table class="w-full text-left">
          <caption class="sr-only">Every removal issued against this listing</caption>
          <thead class="border-b border-neutral-300 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800/50">
            <tr>
              <th scope="col" class="px-4 py-2 font-semibold">Kind</th>
              <th scope="col" class="px-4 py-2 font-semibold">Reason</th>
              <th scope="col" class="px-4 py-2 font-semibold">Issued</th>
              <th scope="col" class="px-4 py-2 font-semibold">Lifted</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-200 dark:divide-neutral-800">
            <% removals.forEach(function (removal) { %>
              <tr data-removal-id="<%= removal.id %>">
                <td data-cell="kind" data-removal="<%= removal.kind %>" class="px-4 py-2"><%= statusLabel(removal.kind) %></td>
                <td class="px-4 py-2"><%= removal.reason %></td>
                <td class="px-4 py-2"><%= formatMoment(removal.createdAt) %></td>
                <td class="px-4 py-2"><%= formatMoment(removal.liftedAt) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</div>
