<div class="flex flex-wrap items-center gap-4">
  <h1 class="text-lg font-semibold">Listings</h1>
</div>

<form method="get" action="/admin/listings" class="mt-4 flex flex-wrap items-end gap-3 rounded border border-neutral-300 bg-white p-3">
  <div>
    <label for="status" class="block text-neutral-600">Status</label>
    <select id="status" name="status" class="mt-1 rounded border border-neutral-400 px-2 py-1">
      <option value="">All</option>
      <% statuses.forEach(function (status) { %>
        <option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= statusLabel(status) %></option>
      <% }) %>
    </select>
  </div>
  <div>
    <label for="seller" class="block text-neutral-600">Seller id</label>
    <input id="seller" name="seller" type="number" min="1" value="<%= filters.seller %>" class="mt-1 w-24 rounded border border-neutral-400 px-2 py-1">
  </div>
  <div>
    <label for="removed" class="block text-neutral-600">Removal</label>
    <select id="removed" name="removed" class="mt-1 rounded border border-neutral-400 px-2 py-1">
      <% removedFilters.forEach(function (option) { %>
        <option value="<%= option %>" <%= filters.removed === option ? 'selected' : '' %>><%= statusLabel(option) %></option>
      <% }) %>
    </select>
  </div>
  <button type="submit" class="rounded bg-neutral-900 px-4 py-2 font-medium text-white">Filter</button>
</form>

<% if (listings.length === 0) { %>
  <%- include('sites/admin/views/partials/empty', { message: 'No listings match these filters.' }) %>
<% } else { %>
  <div class="mt-4 overflow-x-auto rounded border border-neutral-300 bg-white">
    <table class="w-full text-left">
      <caption class="sr-only">Listings</caption>
      <thead class="border-b border-neutral-300 bg-neutral-50">
        <tr>
          <th scope="col" class="px-4 py-2 font-semibold">Listing</th>
          <th scope="col" class="px-4 py-2 font-semibold">Seller</th>
          <th scope="col" class="px-4 py-2 font-semibold">Status</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Price</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Qty</th>
          <th scope="col" class="px-4 py-2 font-semibold">On storefront</th>
          <th scope="col" class="px-4 py-2 font-semibold">Removal</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-200">
        <% listings.forEach(function (listing) { %>
          <tr data-listing="<%= listing.id %>">
            <th scope="row" class="px-4 py-3 font-normal">
              <a href="/admin/listings/<%= listing.id %>" class="font-medium underline"><%= listing.title %></a>
            </th>
            <td data-cell="seller" class="px-4 py-3"><%= listing.sellerName %></td>
            <td data-cell="status" class="px-4 py-3"><%= statusLabel(listing.status) %></td>
            <td data-cell="price" class="px-4 py-3 text-right tabular-nums"><%= formatCents(listing.priceCents) %></td>
            <td data-cell="quantity" class="px-4 py-3 text-right tabular-nums"><%= listing.quantity %></td>
            <td data-cell="on-storefront" class="px-4 py-3"><%= listing.isOnStorefront ? 'Yes' : 'No' %></td>
            <% if (listing.activeRemoval) { %>
              <td data-cell="removal" data-removal="<%= listing.activeRemoval.kind %>" class="px-4 py-3">
                <%= statusLabel(listing.activeRemoval.kind) %> &middot; <%= listing.activeRemoval.reason %>
              </td>
            <% } else { %>
              <td data-cell="removal" class="px-4 py-3 text-neutral-500">None</td>
            <% } %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
