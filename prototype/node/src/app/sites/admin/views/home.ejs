<h1 class="text-lg font-semibold">Overview</h1>

<section aria-labelledby="people-heading" class="mt-6">
  <h2 id="people-heading" class="font-semibold text-neutral-700 dark:text-neutral-300">People</h2>
  <dl class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <%- include('sites/admin/views/partials/stat', { key: 'sellers', label: 'Sellers', value: tallies.sellerCount }) %>
    <%- include('sites/admin/views/partials/stat', { key: 'verified-customers', label: 'Verified customers', value: tallies.customers.verified }) %>
    <%- include('sites/admin/views/partials/stat', { key: 'anonymous-customers', label: 'Anonymous customers', value: tallies.customers.anonymous }) %>
  </dl>
</section>

<section aria-labelledby="money-heading" class="mt-6">
  <div class="flex flex-wrap items-center gap-4">
    <h2 id="money-heading" class="font-semibold text-neutral-700 dark:text-neutral-300">Money</h2>
    <a href="/admin/accounting" class="ml-auto underline">Accounting</a>
  </div>
  <dl class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <%- include('sites/admin/views/partials/stat', { key: 'held', label: 'Held in escrow', value: formatCents(money.heldCents) }) %>
    <%- include('sites/admin/views/partials/stat', { key: 'available', label: 'Released, awaiting payout', value: formatCents(money.availableCents) }) %>
    <%- include('sites/admin/views/partials/stat', { key: 'paid-out', label: 'Paid out', value: formatCents(money.paidOutCents) }) %>
    <%- include('sites/admin/views/partials/stat', { key: 'fees-earned', label: 'Platform fees earned', value: formatCents(money.feesEarnedCents) }) %>
    <%- include('sites/admin/views/partials/stat', { key: 'fees-refunded', label: 'Platform fees refunded', value: formatCents(money.feesRefundedCents) }) %>
    <%- include('sites/admin/views/partials/stat', { key: 'refunded', label: 'Refunded to customers', value: formatCents(money.refundedCents) }) %>
  </dl>
</section>

<section aria-labelledby="traffic-heading" class="mt-6">
  <div class="flex flex-wrap items-center gap-4">
    <h2 id="traffic-heading" class="font-semibold text-neutral-700 dark:text-neutral-300">Traffic</h2>
    <a href="/admin/stats" class="ml-auto underline">Site stats</a>
  </div>
  <dl class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <%- include('sites/admin/views/partials/stat', { key: 'views-today', label: 'Page views today', value: traffic.todayCount }) %>
    <%- include('sites/admin/views/partials/stat', { key: 'views-this-week', label: 'Page views this week', value: traffic.weekCount }) %>
  </dl>
</section>

<section aria-labelledby="listings-heading" class="mt-6">
  <div class="flex flex-wrap items-center gap-4">
    <h2 id="listings-heading" class="font-semibold text-neutral-700 dark:text-neutral-300">Listings</h2>
    <a href="/admin/listings" class="ml-auto underline">All listings</a>
  </div>
  <dl class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <% tallies.listings.forEach((tally) => { %>
      <%- include('sites/admin/views/partials/stat', { key: `listing-${tally.key}`, label: statusLabel(tally.key), value: tally.count }) %>
    <% }) %>
  </dl>
</section>

<section aria-labelledby="orders-heading" class="mt-6">
  <div class="flex flex-wrap items-center gap-4">
    <h2 id="orders-heading" class="font-semibold text-neutral-700 dark:text-neutral-300">Orders</h2>
    <a href="/admin/orders" class="ml-auto underline">All orders</a>
  </div>
  <dl class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <% tallies.orders.forEach((tally) => { %>
      <%- include('sites/admin/views/partials/stat', { key: `order-${tally.key}`, label: statusLabel(tally.key), value: tally.count }) %>
    <% }) %>
  </dl>
</section>

<section aria-labelledby="fulfillments-heading" class="mt-6">
  <div class="flex flex-wrap items-center gap-4">
    <h2 id="fulfillments-heading" class="font-semibold text-neutral-700 dark:text-neutral-300">Fulfillments</h2>
    <a href="/admin/fulfillments" class="ml-auto underline">All fulfillments</a>
  </div>
  <dl class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <% tallies.fulfillments.forEach((tally) => { %>
      <%- include('sites/admin/views/partials/stat', { key: `fulfillment-${tally.key}`, label: statusLabel(tally.key), value: tally.count }) %>
    <% }) %>
  </dl>
</section>
