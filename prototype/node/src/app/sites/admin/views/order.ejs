<h1 class="text-lg font-semibold" data-order="<%= order.id %>">Order <%= order.id %></h1>
<dl class="mt-2 text-neutral-600">
  <div>
    <dt class="inline text-neutral-500">Customer</dt>
    <dd class="inline">
      <a href="/admin/customers/<%= customer.id %>" class="underline"><%= customer.name %></a>
    </dd>
  </div>
  <div><dt class="inline text-neutral-500">Status</dt> <dd class="inline" data-order-status><%= statusLabel(order.status) %></dd></div>
  <div><dt class="inline text-neutral-500">Subtotal</dt> <dd class="inline"><%= formatCents(order.subtotalCents) %></dd></div>
  <div><dt class="inline text-neutral-500">Total</dt> <dd class="inline"><%= formatCents(order.totalCents) %></dd></div>
  <div><dt class="inline text-neutral-500">Placed</dt> <dd class="inline"><%= formatMoment(order.placedAt) %></dd></div>
</dl>

<section class="mt-6" aria-labelledby="items-heading">
  <h2 id="items-heading" class="font-semibold text-neutral-700">Items</h2>
  <% if (items.length === 0) { %>
  <%- include('sites/admin/views/partials/empty', { message: 'No items on this order.' }) %>
  <% } else { %>
  <div class="mt-2 overflow-x-auto rounded border border-neutral-300 bg-white">
    <table class="w-full text-left">
      <caption class="sr-only">This order's items</caption>
      <thead class="border-b border-neutral-300 bg-neutral-50">
        <tr>
          <th scope="col" class="px-4 py-2 font-semibold">Item</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Unit price</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Qty</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Line total</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-200">
        <% items.forEach((item) => { %>
        <tr data-order-item="<%= item.id %>">
          <th scope="row" class="px-4 py-3 font-normal">
            <a href="/admin/listings/<%= item.listingId %>" class="underline"><%= item.title %></a>
          </th>
          <td data-cell="unit-price" class="px-4 py-3 text-right tabular-nums"><%= formatCents(item.unitPriceCents) %></td>
          <td data-cell="quantity" class="px-4 py-3 text-right tabular-nums"><%= item.quantity %></td>
          <td data-cell="line-total" class="px-4 py-3 text-right tabular-nums"><%= formatCents(item.lineTotalCents) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<section class="mt-6" aria-labelledby="payments-heading">
  <h2 id="payments-heading" class="font-semibold text-neutral-700">Payments</h2>
  <% if (payments.length === 0) { %>
  <%- include('sites/admin/views/partials/empty', { message: 'No payment attempts yet.' }) %>
  <% } else { %>
  <div class="mt-2 overflow-x-auto rounded border border-neutral-300 bg-white">
    <table class="w-full text-left">
      <caption class="sr-only">This order's payments</caption>
      <thead class="border-b border-neutral-300 bg-neutral-50">
        <tr>
          <th scope="col" class="px-4 py-2 font-semibold">Status</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Amount</th>
          <th scope="col" class="px-4 py-2 font-semibold">Card</th>
          <th scope="col" class="px-4 py-2 font-semibold">Decline reason</th>
          <th scope="col" class="px-4 py-2 font-semibold">Processed</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-200">
        <% payments.forEach((payment) => { %>
        <tr data-payment="<%= payment.id %>">
          <th scope="row" class="px-4 py-3 font-normal" data-cell="status"><%= statusLabel(payment.status) %></th>
          <td data-cell="amount" class="px-4 py-3 text-right tabular-nums"><%= formatCents(payment.amountCents) %></td>
          <td class="px-4 py-3">&hellip;<%= payment.cardLastFour %></td>
          <td data-cell="decline-reason" class="px-4 py-3">
            <% if (payment.declineReason) { %>
            <%= statusLabel(payment.declineReason) %>
            <% } else { %>
            <span class="text-neutral-500">&mdash;</span>
            <% } %>
          </td>
          <td class="px-4 py-3"><%= formatMoment(payment.processedAt) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<section class="mt-6" aria-labelledby="fulfillments-heading">
  <h2 id="fulfillments-heading" class="font-semibold text-neutral-700">Fulfillments</h2>
  <% if (fulfillments.length === 0) { %>
  <%- include('sites/admin/views/partials/empty', { message: 'No fulfillments yet.' }) %>
  <% } else { %>
  <div class="mt-2 overflow-x-auto rounded border border-neutral-300 bg-white">
    <table class="w-full text-left">
      <caption class="sr-only">This order's fulfillments</caption>
      <thead class="border-b border-neutral-300 bg-neutral-50">
        <tr>
          <th scope="col" class="px-4 py-2 font-semibold">Seller</th>
          <th scope="col" class="px-4 py-2 font-semibold">Status</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Subtotal</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Fee</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Net</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-200">
        <% fulfillments.forEach((fulfillment) => { %>
        <tr data-fulfillment="<%= fulfillment.id %>">
          <th scope="row" class="px-4 py-3 font-normal">
            <a href="/admin/fulfillments/<%= fulfillment.id %>" class="font-medium underline"><%= fulfillment.sellerName %></a>
          </th>
          <td data-cell="status" class="px-4 py-3"><%= statusLabel(fulfillment.status) %></td>
          <td data-cell="subtotal" class="px-4 py-3 text-right tabular-nums"><%= formatCents(fulfillment.subtotalCents) %></td>
          <td data-cell="fee" class="px-4 py-3 text-right tabular-nums"><%= formatCents(fulfillment.feeCents) %></td>
          <td data-cell="net" class="px-4 py-3 text-right tabular-nums"><%= formatCents(fulfillment.netCents) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
