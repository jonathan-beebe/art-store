<%- include('views/partials/head', { title, titleSuffix: 'Admin' }) %>
  <body class="min-h-screen bg-neutral-100 text-sm text-neutral-900 antialiased">
    <%- include('views/partials/debug-alert', { flash, showsDebugMagicLinks }) %>
    <%- include('views/partials/flash', { flash }) %>
    <header class="border-b border-neutral-300 bg-neutral-900 text-neutral-100">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-2">
        <a href="/admin" class="font-semibold">Art Store admin</a>
        <% if (identity.admin) { %>
        <nav aria-label="Admin site" class="flex flex-wrap gap-4 text-neutral-300">
          <a href="/admin" class="hover:text-white">Overview</a>
          <a href="/admin/sellers" class="hover:text-white">Sellers</a>
          <a href="/admin/customers" class="hover:text-white">Customers</a>
          <a href="/admin/listings" class="hover:text-white">Listings</a>
          <a href="/admin/orders" class="hover:text-white">Orders</a>
          <a href="/admin/fulfillments" class="hover:text-white">Fulfillments</a>
          <a href="/admin/accounting" class="hover:text-white">Accounting</a>
          <a href="/admin/payouts" class="hover:text-white">Payouts</a>
          <a href="/admin/ledger" class="hover:text-white">Ledger</a>
          <a href="/admin/stats" class="hover:text-white">Site stats</a>
          <a href="/admin/outbox" class="hover:text-white">Outbox</a>
          <a href="/admin/messages" class="hover:text-white">Messages<%- include('views/partials/unread-badge', {
            classes: 'ml-1 rounded bg-amber-500 px-1.5 py-0.5 text-xs font-medium text-neutral-900 empty:hidden',
            unreadMessageCount,
          }) %></a>
        </nav>
        <div class="ml-auto flex items-center gap-4 text-neutral-300">
          <a href="/admin/account" class="hover:text-white"><%= identity.admin.email %></a>
          <form method="post" action="/admin/logout" class="inline">
  <%- include('views/partials/csrf-field', { csrfToken }) %>
            <button type="submit" class="cursor-pointer hover:text-white">Sign out</button>
          </form>
        </div>
        <% } else { %>
        <div class="ml-auto text-neutral-300">
          <a href="/admin/login" class="hover:text-white">Sign in</a>
        </div>
        <% } %>
      </div>
    </header>
    <%# the page's already-escaped markup %>
    <main class="mx-auto max-w-7xl px-4 py-6"><%- body %></main>
    <script defer src="/app.js"></script>
  </body>
</html>
