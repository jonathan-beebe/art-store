<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> — Admin</title>
    <link rel="stylesheet" href="/app.css" />
  </head>
  <body class="min-h-screen bg-neutral-100 text-neutral-900 antialiased">
    <%- include('views/partials/debug-alert', { flash }) %>
    <%- include('views/partials/flash', { flash }) %>
    <header class="border-b border-neutral-300 bg-neutral-900 text-neutral-100">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 text-sm">
        <a href="/admin" class="font-semibold">Art Store admin</a>
        <ul class="flex gap-4 text-neutral-400">
          <li><a href="/" class="hover:text-white">Storefront</a></li>
          <li><a href="/seller" class="hover:text-white">Seller portal</a></li>
          <% if (identity.admin) { %>
          <li><a href="/admin/account" class="hover:text-white">Account</a></li>
          <li>
            <form method="post" action="/admin/logout">
              <button type="submit" class="cursor-pointer hover:text-white">Sign out</button>
            </form>
          </li>
          <% } else { %>
          <li><a href="/admin/login" class="hover:text-white">Sign in</a></li>
          <% } %>
        </ul>
      </nav>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-8"><%- body %></main>
  </body>
</html>
