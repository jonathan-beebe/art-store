<h1 class="text-2xl font-semibold">Outbox message <%= message.id %></h1>

<dl class="mt-4 grid max-w-xl grid-cols-[8rem_1fr] gap-y-1 rounded border border-neutral-300 bg-white p-4">
  <dt class="font-medium text-neutral-600">To</dt>
  <dd data-field="recipient"><%= message.recipient %></dd>
  <dt class="font-medium text-neutral-600">Subject</dt>
  <dd data-field="subject"><%= message.subject %></dd>
  <dt class="font-medium text-neutral-600">Queued</dt>
  <dd data-field="queued"><%= formatMoment(message.createdAt) %></dd>
  <dt class="font-medium text-neutral-600">Sent</dt>
  <dd data-field="delivered"><%= message.deliveredAt === null ? 'Pending' : formatMoment(message.deliveredAt) %></dd>
</dl>

<% if (message.url !== null) { %>
<p class="mt-4">
  <a href="<%= message.url %>" data-message-link class="font-medium underline"><%= message.url %></a>
</p>
<% } %>

<h2 class="mt-6 font-semibold text-neutral-700">The message as it would be sent</h2>
<pre data-rendered-message class="mt-2 overflow-x-auto rounded border border-neutral-300 bg-white p-4 whitespace-pre-wrap"><%= rendered %></pre>

<p class="mt-4"><a href="/admin/outbox" class="underline">Back to the outbox</a></p>
