<h1 class="text-lg font-semibold">Customers</h1>

<form method="get" action="/admin/customers" class="mt-4 flex flex-wrap items-end gap-3">
  <div>
    <label for="standing" class="block text-sm font-medium text-neutral-700 dark:text-neutral-300">Standing</label>
    <select name="standing" id="standing" class="mt-1 rounded border border-neutral-300 dark:border-neutral-700 px-3 py-1.5 text-sm">
      <option value="all" <% if (standing === 'all') { %>selected<% } %>>All</option>
      <option value="verified" <% if (standing === 'verified') { %>selected<% } %>>Verified</option>
      <option value="anonymous" <% if (standing === 'anonymous') { %>selected<% } %>>Anonymous</option>
      <option value="blocked" <% if (standing === 'blocked') { %>selected<% } %>>Blocked</option>
    </select>
  </div>
  <button type="submit" class="rounded bg-neutral-900 dark:bg-neutral-100 px-3 py-1.5 text-sm font-medium text-white dark:text-neutral-900">Filter</button>
</form>

<% if (rows.length === 0) { %>
<%- include('sites/admin/views/partials/empty', { message: 'No customers match this filter.' }) %>
<% } else { %>
<div class="mt-4 overflow-x-auto rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900">
  <table class="w-full text-left">
    <caption class="sr-only">Every customer</caption>
    <thead class="border-b border-neutral-300 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800/50">
      <tr>
        <th scope="col" class="px-4 py-2 font-semibold">Customer</th>
        <th scope="col" class="px-4 py-2 font-semibold">Joined</th>
        <th scope="col" class="px-4 py-2 text-right font-semibold">Orders</th>
        <th scope="col" class="px-4 py-2 text-right font-semibold">Favorites</th>
        <th scope="col" class="px-4 py-2 text-right font-semibold">Cart lines</th>
        <th scope="col" class="px-4 py-2 font-semibold">Blocked</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-neutral-200 dark:divide-neutral-800">
      <% rows.forEach((row) => { %>
      <tr data-customer="<%= row.id %>" data-standing="<%= row.isBlocked ? 'blocked' : 'unblocked' %>">
        <th scope="row" class="px-4 py-3 font-normal">
          <a href="/admin/customers/<%= row.id %>" class="font-medium underline"><%= row.email ?? 'Anonymous' %></a>
        </th>
        <td class="px-4 py-3"><%= formatMoment(row.createdAt) %></td>
        <td data-cell="orders" class="px-4 py-3 text-right tabular-nums"><%= row.orderCount %></td>
        <td data-cell="favorites" class="px-4 py-3 text-right tabular-nums"><%= row.favoriteCount %></td>
        <td data-cell="cart-lines" class="px-4 py-3 text-right tabular-nums"><%= row.cartLineCount %></td>
        <td data-cell="blocked" class="px-4 py-3"><%= row.isBlocked ? 'Yes' : 'No' %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('views/partials/pager', { page, basePath: '/admin/customers', query: filterQuery, param: 'page' }) %>
<% } %>
