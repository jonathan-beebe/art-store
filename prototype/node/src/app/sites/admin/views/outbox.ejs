<h1 class="text-2xl font-semibold">Outbox</h1>

<p class="mt-2 text-neutral-600">
  Every message the application has queued to leave it. Each one is written
  inside the transaction that caused it, so nothing here belongs to a change
  that rolled back. Draining writes one RFC-5322 <code>.eml</code> file per
  pending message into <code><%= outboxDir %></code>.
</p>

<% if (rows.length === 0) { %>
<%- include('sites/admin/views/partials/empty', { message: 'Nothing has been queued yet.' }) %>
<% } else { %>
<div class="mt-4 overflow-x-auto rounded border border-neutral-300 bg-white">
  <table class="w-full text-left">
    <caption class="sr-only">Every queued message, newest first</caption>
    <thead class="border-b border-neutral-300 bg-neutral-50">
      <tr>
        <th scope="col" class="px-4 py-2 font-semibold">Message</th>
        <th scope="col" class="px-4 py-2 font-semibold">To</th>
        <th scope="col" class="px-4 py-2 font-semibold">Subject</th>
        <th scope="col" class="px-4 py-2 font-semibold">Queued</th>
        <th scope="col" class="px-4 py-2 font-semibold">Sent</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-neutral-200">
      <% rows.forEach((row) => { %>
      <tr data-outbox-message="<%= row.id %>">
        <th scope="row" class="px-4 py-2 font-normal">
          <a href="/admin/outbox/<%= row.id %>" class="font-medium underline">#<%= row.id %></a>
        </th>
        <td data-cell="recipient" class="px-4 py-2"><%= row.recipient %></td>
        <td data-cell="subject" class="px-4 py-2"><%= row.subject %></td>
        <td data-cell="queued" class="px-4 py-2"><%= formatMoment(row.createdAt) %></td>
        <td data-cell="delivered" data-pending="<%= row.deliveredAt === null %>" class="px-4 py-2">
          <%= row.deliveredAt === null ? 'Pending' : formatMoment(row.deliveredAt) %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<section aria-labelledby="drain-outbox-heading" class="mt-6">
  <h2 id="drain-outbox-heading" class="font-semibold text-neutral-700">Send what is waiting</h2>
  <form method="post" action="/admin/outbox/drain" class="mt-2">
    <button type="submit" class="rounded border border-neutral-400 bg-white px-4 py-2 font-medium">
      Drain the outbox
    </button>
  </form>
  <p class="mt-2 text-neutral-600">
    The same work <code>npm run outbox</code> and <code>make outbox</code> do, so
    a cron entry and this button are one code path.
  </p>
</section>
