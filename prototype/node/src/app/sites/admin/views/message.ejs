<h1 class="text-lg font-semibold" data-conversation="<%= thread.conversation.id %>"><%= thread.counterpart %></h1>
<p class="mt-1 text-neutral-600 dark:text-neutral-400"><%= thread.topic %></p>

<ol class="mt-4 space-y-3">
  <% thread.messages.forEach((message) => { %>
  <li data-message="<%= message.id %>" data-sender-type="<%= message.senderType %>" class="rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 p-3">
    <p class="text-neutral-500">
      <span data-cell="sender" class="font-medium text-neutral-700 dark:text-neutral-300"><%= message.senderName %></span>
      &middot;
      <span data-cell="sent-at"><%= formatMoment(message.sentAt) %></span>
    </p>
    <p class="mt-1 whitespace-pre-wrap text-neutral-900 dark:text-neutral-100"><%= message.body %></p>
  </li>
  <% }) %>
</ol>

<% if (thread.mayPost) { %>
<form method="post" action="/admin/messages/<%= thread.conversation.id %>" class="mt-6 max-w-xl space-y-3">
  <%- include('views/partials/csrf-field', { csrfToken }) %>
  <%- include('views/partials/form-error', { formError: typeof replyFormError !== 'undefined' ? replyFormError : null }) %>
  <%- include('views/partials/form-field', {
    name: 'body',
    id: 'body',
    label: 'Reply',
    type: 'textarea',
    value: typeof replyBody !== 'undefined' ? replyBody : '',
    error: typeof replyError !== 'undefined' ? replyError : undefined,
    inputClass: 'mt-1 block w-full rounded border border-neutral-300 dark:border-neutral-700 px-3 py-1.5 text-sm',
    wrapperClass: '',
  }) %>
  <button type="submit" class="cursor-pointer rounded bg-neutral-900 dark:bg-neutral-100 px-3 py-1.5 text-sm font-medium text-white dark:text-neutral-900">
    Send
  </button>
</form>
<% } %>
