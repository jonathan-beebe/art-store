<div class="flex flex-wrap items-center gap-4">
  <h1 class="text-lg font-semibold">Orders</h1>
</div>

<form method="get" action="/admin/orders" class="mt-4 flex flex-wrap items-end gap-3 rounded border border-neutral-300 bg-white p-3">
  <div>
    <label for="status" class="block text-neutral-600">Status</label>
    <select id="status" name="status" class="mt-1 rounded border border-neutral-400 px-2 py-1">
      <option value="">All</option>
      <% statuses.forEach(function (status) { %>
        <option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= statusLabel(status) %></option>
      <% }) %>
    </select>
  </div>
  <div>
    <label for="customer" class="block text-neutral-600">Customer id</label>
    <input id="customer" name="customer" type="number" min="1" value="<%= filters.customer %>" class="mt-1 w-24 rounded border border-neutral-400 px-2 py-1">
  </div>
  <button type="submit" class="rounded bg-neutral-900 px-4 py-2 font-medium text-white">Filter</button>
</form>

<% if (orders.length === 0) { %>
  <%- include('sites/admin/views/partials/empty', { message: 'No orders match these filters.' }) %>
<% } else { %>
  <div class="mt-4 overflow-x-auto rounded border border-neutral-300 bg-white">
    <table class="w-full text-left">
      <caption class="sr-only">Orders</caption>
      <thead class="border-b border-neutral-300 bg-neutral-50">
        <tr>
          <th scope="col" class="px-4 py-2 font-semibold">Order</th>
          <th scope="col" class="px-4 py-2 font-semibold">Customer</th>
          <th scope="col" class="px-4 py-2 font-semibold">Status</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Items</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Subtotal</th>
          <th scope="col" class="px-4 py-2 text-right font-semibold">Total</th>
          <th scope="col" class="px-4 py-2 font-semibold">Placed</th>
          <th scope="col" class="px-4 py-2 font-semibold">Fulfillments</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-200">
        <% orders.forEach(function (order) { %>
          <tr data-order="<%= order.id %>">
            <th scope="row" class="px-4 py-2 font-normal">
              <a href="/admin/orders/<%= order.id %>" class="font-medium underline"><%= order.id %></a>
            </th>
            <td data-cell="customer" class="px-4 py-2"><%= order.customerEmail ?? 'Anonymous' %></td>
            <td data-cell="status" class="px-4 py-2"><%= statusLabel(order.status) %></td>
            <td data-cell="item-count" class="px-4 py-2 text-right tabular-nums"><%= order.itemCount %></td>
            <td data-cell="subtotal" class="px-4 py-2 text-right tabular-nums"><%= formatCents(order.subtotalCents) %></td>
            <td data-cell="total" class="px-4 py-2 text-right tabular-nums"><%= formatCents(order.totalCents) %></td>
            <td class="px-4 py-2"><%= formatMoment(order.placedAt) %></td>
            <td data-cell="fulfillment-statuses" class="px-4 py-2">
              <%= order.fulfillmentStatuses.map(statusLabel).join(', ') %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
