<h1 class="text-2xl font-semibold">Accounting</h1>
<p class="mt-3 max-w-2xl text-sm text-neutral-600">
  Every seller's escrow balance, reconciled against what their payouts actually
  sent, plus the platform totals the whole ledger folds to.
</p>

<% if (accounts.length === 0) { %>
<%- include('sites/admin/views/partials/empty', { message: 'No sellers yet.' }) %>
<% } else { %>
<div class="mt-4 overflow-x-auto rounded border border-neutral-300 bg-white">
  <table class="w-full text-left">
    <caption class="sr-only">Seller accounts, reconciled against payouts, with platform totals</caption>
    <thead class="border-b border-neutral-300 bg-neutral-50">
      <tr>
        <th scope="col" class="px-4 py-2 font-semibold">Seller</th>
        <th scope="col" class="px-4 py-2 text-right font-semibold">Held</th>
        <th scope="col" class="px-4 py-2 text-right font-semibold">Available</th>
        <th scope="col" class="px-4 py-2 text-right font-semibold">Paid out</th>
        <th scope="col" class="px-4 py-2 text-right font-semibold">Payout total</th>
        <th scope="col" class="px-4 py-2 font-semibold">Reconciles</th>
        <th scope="col" class="px-4 py-2 text-right font-semibold">Lifetime subtotal</th>
        <th scope="col" class="px-4 py-2 text-right font-semibold">Fee earned</th>
        <th scope="col" class="px-4 py-2 text-right font-semibold">Lifetime net</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-neutral-200">
      <% accounts.forEach((account) => { %>
      <tr data-seller="<%= account.sellerId %>">
        <th scope="row" class="px-4 py-2 font-normal"><%= account.sellerName %></th>
        <td data-cell="held" class="px-4 py-2 text-right tabular-nums"><%= formatCents(account.heldCents) %></td>
        <td data-cell="available" class="px-4 py-2 text-right tabular-nums"><%= formatCents(account.availableCents) %></td>
        <td data-cell="paid-out" class="px-4 py-2 text-right tabular-nums"><%= formatCents(account.paidOutCents) %></td>
        <td data-cell="payout-total" class="px-4 py-2 text-right tabular-nums"><%= formatCents(account.payoutTotalCents) %></td>
        <td data-cell="reconciles" class="px-4 py-2"><%= account.reconciles ? 'Yes' : 'No' %></td>
        <td data-cell="lifetime-subtotal" class="px-4 py-2 text-right tabular-nums"><%= formatCents(account.lifetimeSubtotalCents) %></td>
        <td data-cell="lifetime-fee" class="px-4 py-2 text-right tabular-nums"><%= formatCents(account.lifetimeFeeCents) %></td>
        <td data-cell="lifetime-net" class="px-4 py-2 text-right tabular-nums"><%= formatCents(account.lifetimeNetCents) %></td>
      </tr>
      <% }) %>
    </tbody>
    <tfoot class="border-t border-neutral-300 bg-neutral-50">
      <tr data-totals="platform">
        <th scope="row" class="px-4 py-2 font-semibold">Platform totals</th>
        <td data-cell="held" class="px-4 py-2 text-right font-semibold tabular-nums"><%= formatCents(totals.heldCents) %></td>
        <td data-cell="available" class="px-4 py-2 text-right font-semibold tabular-nums"><%= formatCents(totals.availableCents) %></td>
        <td data-cell="paid-out" class="px-4 py-2 text-right font-semibold tabular-nums"><%= formatCents(totals.paidOutCents) %></td>
        <td colspan="3"></td>
        <td data-cell="fees-earned" class="px-4 py-2 text-right font-semibold tabular-nums"><%= formatCents(totals.feesEarnedCents) %></td>
        <td></td>
      </tr>
    </tfoot>
  </table>
</div>
<% } %>
