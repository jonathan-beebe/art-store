<div class="flex flex-wrap items-center gap-4">
  <h1 class="text-lg font-semibold">Request <span data-request-id><%= requestId %></span></h1>
  <a href="/admin/logs?request=<%= encodeURIComponent(requestId) %>" class="underline">Open in the log list</a>
</div>

<% if (!storeAvailable) { %>
  <%- include('sites/admin/views/partials/empty', { message: 'The log store is unavailable — LOG_DATABASE_FILE is off or the store failed to open. Every line still goes to stdout.' }) %>
<% } else if (lines.length === 0) { %>
  <%- include('sites/admin/views/partials/empty', { message: 'No lines are stored for this request. It may be outside the retention window.' }) %>
<% } else { %>
  <dl class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
    <%- include('sites/admin/views/partials/stat', { key: 'lines', label: 'Lines', value: totalCount }) %>
    <%- include('sites/admin/views/partials/stat', { key: 'first', label: 'First line', value: header.firstTs }) %>
    <%- include('sites/admin/views/partials/stat', { key: 'last', label: 'Last line', value: header.lastTs }) %>
    <%- include('sites/admin/views/partials/stat', { key: 'duration', label: 'Duration (ms)', value: header.durationMs ?? '—' }) %>
    <div class="rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 px-3 py-2" data-stat="session">
      <dt class="text-neutral-500">Session</dt>
      <dd class="mt-1 text-lg font-semibold"><% if (header.sessionId === null) { %>—<% } else { %><%- linkedIds(header.sessionId) %><% } %></dd>
    </div>
    <div class="rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 px-3 py-2" data-stat="actor">
      <dt class="text-neutral-500">Actor</dt>
      <dd class="mt-1 text-lg font-semibold">
        <% if (header.actorId === null) { %><%= header.actorType ?? '—' %><% } else { %>
          <%= header.actorType ?? '' %> <%- linkedIds(header.actorId) %>
        <% } %>
      </dd>
    </div>
  </dl>

  <% if (totalCount > lines.length) { %>
    <p data-cap-notice class="mt-4 rounded border border-amber-500 bg-white dark:bg-neutral-900 p-3 text-amber-700 dark:text-amber-400">
      Showing the first <%= lineCap %> of <%= totalCount %> lines.
    </p>
  <% } %>

  <ol class="mt-4 space-y-3">
    <% lines.forEach(function (line) { %>
      <li data-line="<%= line.id %>" class="rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 p-3">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span data-cell="msg" class="font-medium"><%= line.msg ?? '—' %></span>
          <span data-cell="level" class="rounded bg-neutral-100 dark:bg-neutral-800 px-1.5 py-0.5 text-xs"><%= line.level ?? '—' %></span>
          <span data-cell="event" class="text-neutral-600 dark:text-neutral-400">
            <%= line.event === null ? '—' : line.event %><% if (line.phase !== null) { %> · <%= line.phase %><% } %>
          </span>
          <span data-cell="ts" class="ml-auto tabular-nums text-neutral-500"><%= line.ts %></span>
          <% if (line.durationMs !== null) { %>
            <span data-cell="duration" class="tabular-nums text-neutral-500"><%= line.durationMs %> ms</span>
          <% } %>
        </div>
        <% if (line.data !== null) { %>
          <details open class="mt-2">
            <summary class="cursor-pointer text-neutral-500">data</summary>
            <pre class="mt-1 overflow-x-auto rounded bg-neutral-50 dark:bg-neutral-800/50 p-2 text-xs"><%- linkedIds(formatJson(line.data)) %></pre>
          </details>
        <% } %>
        <% if (line.error !== null) { %>
          <details open class="mt-2">
            <summary class="cursor-pointer text-neutral-500">error</summary>
            <pre class="mt-1 overflow-x-auto rounded bg-neutral-50 dark:bg-neutral-800/50 p-2 text-xs"><%- linkedIds(formatJson(line.error)) %></pre>
          </details>
        <% } %>
      </li>
    <% }) %>
  </ol>
<% } %>
