<article class="grid gap-14 lg:grid-cols-2">
  <img
    src="<%= listingImageSource(listing.imagePath, listing.title) %>"
    alt=""
    class="aspect-square w-full rounded-3xl bg-neutral-50 object-cover"
  />

  <div class="max-w-lg">
    <h1 class="text-4xl font-light leading-tight tracking-tight"><%= listing.title %></h1>
    <p class="mt-3 text-lg text-neutral-500"><%= shopName(seller) %></p>
    <p class="mt-8 text-2xl"><%= formatCents(listing.priceCents) %></p>

    <dl class="mt-8 grid grid-cols-2 gap-y-4 border-y border-neutral-100 py-6 text-base">
      <dt class="text-neutral-500">Medium</dt>
      <dd><%= listing.medium || 'Mixed' %></dd>
      <dt class="text-neutral-500">Dimensions</dt>
      <dd><%= listing.dimensions || 'Unlisted' %></dd>
      <dt class="text-neutral-500">Available</dt>
      <dd data-availability><%= isPurchasable ? listing.quantity : 'Sold out' %></dd>
    </dl>

    <% if (listing.description) { %>
    <p class="mt-8 text-lg leading-relaxed whitespace-pre-line text-neutral-700">
      <%= listing.description %>
    </p>
    <% } %>

    <% if (!canShop) { %>
    <p
      role="alert"
      data-blocked
      class="mt-10 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-rose-900"
    >
      <%= blockedNotice %>
    </p>
    <% } %>

    <div class="mt-10 flex flex-wrap items-end gap-4">
      <% if (isPurchasable && canShop) { %>
      <form method="post" action="/cart/<%= listing.slug %>" class="flex items-end gap-4">
        <% if (listing.quantity > 1) { %>
        <div>
          <label
            for="quantity"
            class="block text-xs uppercase tracking-wide text-neutral-500"
          >
            Quantity
          </label>
          <input
            type="number"
            name="quantity"
            id="quantity"
            value="1"
            min="1"
            max="<%= listing.quantity %>"
            class="mt-2 w-24 rounded-lg border border-neutral-300 px-4 py-3 text-lg"
          />
        </div>
        <% } %>
        <button
          type="submit"
          class="cursor-pointer rounded-full bg-amber-600 px-8 py-3 text-base text-white hover:bg-amber-700"
        >
          Add to cart
        </button>
      </form>
      <% } %>

      <form method="post" action="/art/<%= listing.slug %>/favorite">
        <button
          type="submit"
          class="cursor-pointer rounded-full border border-neutral-300 px-8 py-3 text-base hover:border-amber-600"
        >
          <%= isFavorited ? 'Remove from favorites' : 'Favorite' %>
        </button>
      </form>
    </div>
  </div>
</article>

<section class="mt-24 max-w-2xl">
  <h2 class="text-2xl font-light tracking-tight">Questions</h2>

  <% if (faqs.length === 0) { %>
  <p class="mt-6 text-lg text-neutral-500">No questions yet.</p>
  <% } else { %>
  <dl class="mt-6 divide-y divide-neutral-100 border-y border-neutral-100">
    <% faqs.forEach(function (faq) { %>
    <div class="py-6">
      <dt class="text-lg"><%= faq.question %></dt>
      <dd class="mt-2 text-base text-neutral-600"><%= faq.answer %></dd>
    </div>
    <% }) %>
  </dl>
  <% } %>

  <form method="post" action="/art/<%= listing.slug %>/questions" class="mt-10">
    <label for="question" class="block text-lg">Ask the seller a question</label>
    <textarea
      name="body"
      id="question"
      rows="4"
      class="mt-3 w-full rounded-2xl border border-neutral-300 px-5 py-4 text-lg"
      placeholder="What would you like to know?"
    ></textarea>
    <button
      type="submit"
      class="mt-4 cursor-pointer rounded-full bg-amber-600 px-8 py-3 text-base text-white hover:bg-amber-700"
    >
      Send question
    </button>
  </form>
</section>
