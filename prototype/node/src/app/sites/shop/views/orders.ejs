<h1 class="text-4xl font-light tracking-tight">Orders</h1>

<% if (orders.length === 0) { %>
<p class="mt-10 text-lg text-neutral-500">No orders yet.</p>
<a
  href="/"
  class="mt-8 inline-block rounded-full bg-amber-600 px-8 py-3 text-base text-white hover:bg-amber-700"
>
  Browse the art
</a>
<% } else { %>
<ul class="mt-12 divide-y divide-neutral-100 border-y border-neutral-100">
  <% orders.forEach(function (order) { %>
  <li class="flex flex-wrap items-baseline justify-between gap-6 py-7">
    <div>
      <a href="/orders/<%= order.id %>" class="text-lg underline hover:text-amber-700">
        Order <%= order.id %>
      </a>
      <p class="mt-1 text-base text-neutral-500"><%= order.titles.join(', ') %></p>
    </div>

    <div class="text-right">
      <p class="text-base text-neutral-400"><%= dayLabel(order.placedAt) %></p>
      <p class="mt-1 text-lg"><%= formatCents(order.totalCents) %></p>
      <p class="mt-1 text-base text-neutral-500"><%= statusLabel(order.status) %></p>
    </div>
  </li>
  <% }) %>
</ul>
<% } %>
