<h1 class="text-4xl font-light tracking-tight">Checkout</h1>

<% if (unavailable.length > 0) { %>
<div role="alert" class="mt-8 max-w-xl rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-rose-900">
  <p>Take these out of your cart before placing the order:</p>
  <ul class="mt-2 list-disc pl-5">
    <% unavailable.forEach(function (line) { %>
    <li><%= line.title %> — <%= line.notice %></li>
    <% }) %>
  </ul>
</div>
<% } %>

<% if (missingParts.length > 0) { %>
<div role="alert" class="mt-8 max-w-xl rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-rose-900">
  <p>Fill in the following before placing the order:</p>
  <ul class="mt-2 list-disc pl-5">
    <% missingParts.forEach(function (part) { %>
    <% const field = fields.find(function (f) { return f.part === part }) %>
    <li><%= field ? field.label : 'Email address' %></li>
    <% }) %>
  </ul>
</div>
<% } %>

<div class="mt-12 grid gap-16 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
  <form method="post" action="/checkout" class="max-w-xl">
    <h2 class="text-xs uppercase tracking-wide text-neutral-500">Contact</h2>

    <div class="mt-4">
      <label for="email" class="block text-base">Email address</label>
      <input
        type="email"
        name="email"
        id="email"
        value="<%= email %>"
        required
        autocomplete="email"
        <%= isVerified ? 'readonly' : '' %>
        class="mt-2 block w-full rounded-lg border border-neutral-300 px-4 py-3 text-lg read-only:bg-neutral-50"
      />
    </div>

    <% if (!isVerified) { %>
    <p class="mt-3 text-base text-neutral-500">
      We email a link to this address. Opening it verifies you and takes you straight to payment.
    </p>
    <% } %>

    <h2 class="mt-12 text-xs uppercase tracking-wide text-neutral-500">Shipping</h2>

    <% fields.forEach(function (field) { %>
    <div class="mt-4">
      <label for="<%= field.name %>" class="block text-base"><%= field.label %></label>
      <input
        type="text"
        name="<%= field.name %>"
        id="<%= field.name %>"
        value="<%= shipping[field.part] || '' %>"
        autocomplete="<%= field.autocomplete %>"
        <%= field.isRequired ? 'required' : '' %>
        class="mt-2 block w-full rounded-lg border border-neutral-300 px-4 py-3 text-lg"
      />
    </div>
    <% }) %>

    <% if (isVerified) { %>
    <h2 class="mt-12 text-xs uppercase tracking-wide text-neutral-500">Payment</h2>
    <%- include('sites/shop/views/partials/card-fields') %>
    <% } %>

    <button
      type="submit"
      class="mt-10 cursor-pointer rounded-full bg-amber-600 px-8 py-3 text-base text-white hover:bg-amber-700"
    >
      Place order
    </button>
  </form>

  <aside>
    <h2 class="text-xs uppercase tracking-wide text-neutral-500">Order</h2>

    <ul class="mt-4 divide-y divide-neutral-100 border-y border-neutral-100">
      <% lines.forEach(function (line) { %>
      <li class="flex items-baseline justify-between gap-6 py-4">
        <span class="text-base"><%= line.title %> &times; <%= line.quantity %></span>
        <span class="text-base"><%= formatCents(line.unitPriceCents * line.quantity) %></span>
      </li>
      <% }) %>
    </ul>

    <p class="mt-6 flex items-baseline justify-between text-lg">
      <span>Total</span>
      <span data-checkout-total><%= formatCents(totals.subtotalCents) %></span>
    </p>
  </aside>
</div>
