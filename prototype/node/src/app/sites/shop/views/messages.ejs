<h1 class="text-4xl font-light tracking-tight">Messages</h1>

<% if (conversations.length === 0) { %>
<p class="mt-10 text-lg text-neutral-500">
  Nothing here yet. Ask a seller a question or contact support to start a conversation.
</p>
<% } else { %>
<ul class="mt-16 divide-y divide-neutral-100 border-y border-neutral-100">
  <% conversations.forEach(function (conversation) { %>
  <li data-conversation class="py-6">
    <a
      href="<%= conversation.path %>"
      class="flex flex-wrap items-baseline justify-between gap-4 hover:text-amber-700"
    >
      <span>
        <span class="text-lg"><%= conversation.counterpart %></span>
        <span class="ml-2 text-sm text-neutral-500"><%= conversation.topic %></span>
      </span>
      <span class="text-sm text-neutral-500"><%= dayLabel(conversation.lastMessageAt) %></span>
    </a>
    <% if (conversation.preview) { %>
    <p class="mt-2 text-base text-neutral-600"><%= conversation.preview %></p>
    <% } %>
    <span
      data-unread-count="<%= conversation.unreadCount %>"
      class="mt-2 inline-block rounded-full px-2 py-0.5 text-xs <% if (conversation.unreadCount > 0) { %>bg-amber-600 text-white<% } else { %>text-neutral-400<% } %>"
    >
      <%= conversation.unreadCount > 0 ? conversation.unreadCount + ' unread' : 'Read' %>
    </span>
  </li>
  <% }) %>
</ul>
<% } %>
