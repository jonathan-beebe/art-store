<h1 class="text-4xl font-light tracking-tight">Order #<%= order.id %></h1>

<p class="mt-3 text-lg text-neutral-500">
  <span data-order-status><%= statusLabel(order.status) %></span> &middot; <%=
  formatCents(order.totalCents) %> &middot; placed <%= dayLabel(order.placedAt) %>
</p>

<% if (isUnpaid && !isPayable) { %>
<div
  role="status"
  data-verification-notice
  class="mt-10 max-w-xl rounded-2xl border border-amber-200 bg-amber-50 p-6 text-amber-900"
>
  <p class="text-lg">Check your email</p>
  <p class="mt-2 text-base">
    A link is on its way to <%= order.email %>. Open it to verify your address and pay for this
    order.
  </p>
  <p class="mt-4 text-base">
    <a href="/orders/<%= order.id %>/pay" class="underline">Already verified? Sign in to pay</a>
  </p>
</div>
<% } %>

<% if (isPayable) { %>
<section class="mt-10 max-w-xl rounded-2xl border border-neutral-200 p-6">
  <h2 class="text-lg">Payment</h2>

  <%- include('sites/shop/views/partials/decline-notice', { declineMessage }) %>

  <form method="post" action="/orders/<%= order.id %>/pay" class="mt-4">
    <%- include('sites/shop/views/partials/card-fields') %>

    <button
      type="submit"
      class="mt-8 cursor-pointer rounded-full bg-amber-600 px-8 py-3 text-base text-white hover:bg-amber-700"
    >
      Pay <%= formatCents(order.totalCents) %>
    </button>
  </form>
</section>
<% } %>

<% if (isCancellable) { %>
<form method="post" action="/orders/<%= order.id %>/cancel" class="mt-10">
  <button
    type="submit"
    class="cursor-pointer rounded-full border border-neutral-300 px-6 py-2 text-base hover:border-amber-600"
  >
    Cancel this order
  </button>
</form>
<% } %>

<div class="mt-16 grid gap-14 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
  <div>
    <% fulfillments.forEach(function (fulfillment) { %>
    <section data-fulfillment class="border-t border-neutral-100 py-8 first:border-t-0 first:pt-0">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="text-lg"><%= shopName(fulfillment.seller) %></h2>
        <p data-fulfillment-status class="text-base text-neutral-500">
          <%= statusLabel(fulfillment.status) %>
        </p>
      </div>

      <% if (fulfillment.carrier) { %>
      <p data-tracking class="mt-2 text-base text-neutral-500">
        <%= fulfillment.carrier %> &middot; tracking <%= fulfillment.trackingNumber %>
      </p>
      <% } %>

      <ul class="mt-4 space-y-2">
        <% fulfillment.items.forEach(function (item) { %>
        <li class="flex items-baseline justify-between gap-6 text-base">
          <span><%= item.title %> &times; <%= item.quantity %></span>
          <span><%= formatCents(item.lineTotalCents) %></span>
        </li>
        <% }) %>
      </ul>

      <div class="mt-6 flex flex-wrap gap-4">
        <% if (fulfillment.canConfirmDelivery) { %>
        <form
          method="post"
          action="/orders/<%= order.id %>/fulfillments/<%= fulfillment.id %>/delivered"
        >
          <button
            type="submit"
            class="cursor-pointer rounded-full border border-neutral-300 px-6 py-2 text-base hover:border-amber-600"
          >
            Confirm delivery
          </button>
        </form>
        <% } %>

        <form
          method="post"
          action="/orders/<%= order.id %>/fulfillments/<%= fulfillment.id %>/messages"
        >
          <button
            type="submit"
            class="cursor-pointer rounded-full border border-neutral-300 px-6 py-2 text-base hover:border-amber-600"
          >
            Message the seller
          </button>
        </form>
      </div>
    </section>
    <% }) %>
  </div>

  <aside>
    <h2 class="text-xs uppercase tracking-wide text-neutral-500">Shipping to</h2>
    <address class="mt-4 text-base not-italic leading-relaxed text-neutral-700">
      <%= order.shippingName %><br />
      <%= order.shippingLine1 %><br />
      <% if (order.shippingLine2) { %><%= order.shippingLine2 %><br /><% } %>
      <%= order.shippingCity %>, <%= order.shippingRegion %><br />
      <%= order.shippingPostalCode %><br />
      <%= order.shippingCountry %>
    </address>
  </aside>
</div>
