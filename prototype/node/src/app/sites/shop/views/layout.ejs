<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> — Art Store</title>
    <link rel="stylesheet" href="/app.css" />
  </head>
  <body class="min-h-screen bg-white text-neutral-900 antialiased">
    <%- include('views/partials/debug-alert', { flash }) %>
    <%- include('views/partials/flash', { flash }) %>
    <header class="border-b border-neutral-200">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-6">
        <a href="/" class="text-lg tracking-wide text-neutral-900">Art Store</a>
        <ul class="flex gap-6 text-sm text-neutral-600">
          <li><a href="/seller" class="hover:text-neutral-900">Sell</a></li>
        </ul>
      </nav>
    </header>
    <main class="mx-auto max-w-5xl px-6 py-16"><%- body %></main>
    <footer class="mx-auto max-w-5xl px-6 py-12 text-sm text-neutral-500">
      Original work from independent artists.
    </footer>
  </body>
</html>
