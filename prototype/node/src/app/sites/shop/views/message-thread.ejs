<h1 class="text-4xl font-light tracking-tight"><%= thread.topic %></h1>
<p class="mt-3 text-lg text-neutral-500">with <%= thread.counterpart %></p>

<ul class="mt-12 max-w-2xl space-y-8">
  <% thread.messages.forEach(function (message) { %>
  <li data-message>
    <p class="text-sm text-neutral-500">
      <%= message.senderName %> &middot; <%= dayLabel(message.sentAt) %>
    </p>
    <p class="mt-1 whitespace-pre-line text-lg"><%= message.body %></p>
  </li>
  <% }) %>
</ul>

<% if (thread.mayPost) { %>
<form method="post" action="/messages/<%= thread.conversation.id %>" class="mt-12 max-w-2xl">
  <label for="body" class="sr-only">Reply</label>
  <textarea
    name="body"
    id="body"
    rows="4"
    class="w-full rounded-2xl border border-neutral-300 px-5 py-4 text-lg"
    placeholder="Write a reply…"
  ></textarea>
  <button
    type="submit"
    class="mt-4 cursor-pointer rounded-full bg-amber-600 px-8 py-3 text-base text-white hover:bg-amber-700"
  >
    Send
  </button>
</form>
<% } else { %>
<p
  role="status"
  class="mt-12 max-w-2xl rounded-xl border border-neutral-200 bg-neutral-50 px-4 py-3 text-neutral-600"
>
  This account is blocked and cannot send messages.
</p>
<% } %>
