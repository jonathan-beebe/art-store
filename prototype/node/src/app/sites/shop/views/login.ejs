<h1 class="text-4xl font-light tracking-tight">Sign in</h1>
<p class="mt-6 max-w-xl text-lg text-neutral-600">
  There's no password: submit your address and we send a sign-in link. In this
  prototype the link is printed at the top of this page instead of emailed.
</p>
<form method="post" action="<%= loginPath %>" class="mt-10 max-w-md space-y-6">
  <%- include('views/partials/csrf-field', { csrfToken }) %>
  <div>
    <label for="email" class="block text-base">Email address</label>
    <input
      type="email"
      name="email"
      id="email"
      required
      autofocus
      class="mt-2 block w-full rounded-lg border border-neutral-300 px-4 py-3 text-lg"
    />
  </div>
  <% if (redirectTo) { %>
  <input type="hidden" name="redirect_to" value="<%= redirectTo %>" />
  <% } %>
  <button
    type="submit"
    class="cursor-pointer rounded-full bg-amber-600 px-8 py-3 text-base text-white hover:bg-amber-700"
  >
    Email me a sign-in link
  </button>
</form>
