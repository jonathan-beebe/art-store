# Classic per-request mode: no `worker` block. Octane-style worker mode
# keeps one PHP process across requests, which App\Logging\LogStore's
# per-request state assumes it never has to survive.
{
	# The unread badge is a server-rendered count only now (no stream, no
	# client polling), so nothing in this application holds a request open:
	# every request is an ordinary ~10ms round trip that finishes and frees
	# its thread. The pool is sized for concurrent-request throughput, not
	# for held connections — a modest explicit floor rather than
	# FrankenPHP's own default (2×CPU, which is 2 threads on this
	# instance's single CPU), with headroom for a burst of concurrent
	# requests. FRANKENPHP_NUM_THREADS / FRANKENPHP_MAX_THREADS override.
	frankenphp {
		num_threads {$FRANKENPHP_NUM_THREADS:4}
		max_threads {$FRANKENPHP_MAX_THREADS:8}
	}
	auto_https off
	servers {
		# private_ranges covers a same-host or private-network proxy;
		# CADDY_TRUSTED_PROXIES adds a fronting platform's own address
		# (space-separated) when that isn't enough. A distinct variable
		# from Laravel's own TRUSTED_PROXIES (see bootstrap/app.php): that
		# one also accepts `*`, which this static IP-range list cannot.
		trusted_proxies static private_ranges {$CADDY_TRUSTED_PROXIES}
	}
}

:8000 {
	root * /var/www/src/public
	encode zstd gzip
	php_server
}
