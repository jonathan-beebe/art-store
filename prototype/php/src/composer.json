{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5.12",
        "tomasvotruba/cognitive-complexity": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "tests/FunctionOverrides.php"
        ]
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "deploy": [
            "Composer\\Config::disableProcessTimeout",
            "mkdir -p storage/app/public storage/framework/cache storage/framework/sessions storage/framework/testing storage/framework/views storage/logs",
            "touch ${DB_DATABASE:-database/database.sqlite} ${ANALYTICS_DATABASE_FILE:-storage/analytics.sqlite3}",
            "@php artisan migrate --force",
            "@php artisan db:seed --force",
            "frankenphp run --config /etc/frankenphp/Caddyfile --adapter caddyfile"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=1G vendor/bin/pest --parallel --passthru-php='-d memory_limit=1G'"
        ],
        "test:coverage": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=2G -d pcov.enabled=1 vendor/bin/pest --parallel --passthru-php='-d pcov.enabled=1 -d memory_limit=1G' --coverage --min=95 --coverage-html coverage"
        ],
        "analyse": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/phpstan analyse"
        ],
        "lint": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/pint --test"
        ],
        "lint:all": [
            "@lint",
            "@analyse"
        ],
        "lint:fix": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/pint"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.33"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
