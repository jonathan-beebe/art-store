includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest/extension.neon
    - vendor/tomasvotruba/cognitive-complexity/config/extension.neon
    # The complexity debt standing when the gate arrived, worked off ticket
    # by ticket; an entry a refactor clears must leave with it, and phpstan
    # fails on entries that no longer match, so the list only shrinks.
    - phpstan-baseline.neon

parameters:
    level: max
    # The result cache lives in the bind-mounted src tree (gitignored) rather
    # than the container's own /tmp, so a warm cache survives the container
    # `docker compose run` discards after every invocation.
    tmpDir: .phpstan-cache
    cognitive_complexity:
        class: 50
        function: 8
    parseModelCastsMethod: true
    checkConfigTypes: true
    configDirectories:
        - config
    stubFiles:
        - phpstan/pest-refs.stub
        - phpstan/pest-functions.stub
        - phpstan/pest-test-call.stub
        - phpstan/pest-tap-proxy.stub
        - phpstan/pest-expectation.stub
    paths:
        - app
        - database
        - routes
        - tests
