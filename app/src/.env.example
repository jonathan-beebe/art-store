APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stdout
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MAGIC_LINK_DELIVERY=session
MAGIC_LINK_EXPIRY_MINUTES=15

NOTIFICATION_CHANNELS=database

STALE_ORDER_HOURS=24

# The home page's featured band (DSGN-007): "listing" (a slug) or "category"
# (a /browse/{categoryPath} path).
STOREFRONT_FEATURED_TYPE=listing
STOREFRONT_FEATURED_VALUE=the-burrow-at-dusk

# docs/alignment.md §3. "<count>/<window>" (window "<n>s", "<n>m", or "<n>h"),
# or "off" to disable. Unset falls back to the default named after each
# variable; a malformed value refuses to boot.
#
# The two sign-in limits are off for local development: a demo signs in as
# three actors in a row, and the debug magic link is the only way in, so
# five requests per quarter hour locks a developer out of their own stack.
# Production leaves both unset and takes the §3 defaults (5/15m, 20/15m).
RATE_LIMIT_MAGIC_LINK_REQUEST=off
RATE_LIMIT_MAGIC_LINK_CONSUME=off
RATE_LIMIT_MESSAGE_POST=30/1h
RATE_LIMIT_CONVERSATION_OPEN=10/1h
RATE_LIMIT_CHECKOUT=10/1h
RATE_LIMIT_PAYMENT_ATTEMPT=5/15m
RATE_LIMIT_LISTING_WRITE=60/1h
RATE_LIMIT_STORE_WRITE=60/1h
RATE_LIMIT_MCP_REQUEST=600/1h

# docs/alignment.md §3. Comma-separated proxy IPs/CIDRs to trust the
# X-Forwarded-For header from, or "*" to trust the immediate proxy
# unconditionally. Unset (the default): the client ip is read from the
# socket, as it is in development.
# TRUSTED_PROXIES=

# docs/logging.md, docs/alignment.md §2.5. The SQLite file every stdout
# line is also mirrored into, beside the commerce database ("off" disables
# the store). Unset defaults to storage/logs.sqlite3, next to the commerce
# database.
# LOG_DATABASE_FILE=

# The SQLite file page view counts and analytics events are written into.
# Unset defaults to storage/analytics.sqlite3.
# ANALYTICS_DATABASE_FILE=

# The seller support hub's desk facts (config/support.php). Unset falls
# back to a bracketed placeholder for a fact not known yet, or a working
# default for one that is.
# SUPPORT_ROLE=
# SUPPORT_REPLY_TIME=
# SUPPORT_EMAIL=
# SUPPORT_PHONE=
# SUPPORT_PHONE_HOURS=
# SUPPORT_BOOKING_URL=
# SUPPORT_HOURS_OPEN=
# SUPPORT_HOURS_CLOSE=

# How long a mirrored line survives before `orders:sweep` prunes it ("off"
# disables pruning); a malformed value refuses to boot.
LOG_RETENTION_DAYS=14

# docs/analytics.md, docs/alignment.md §2.6. How long an analytics_events
# row survives before `orders:sweep` prunes it ("off" disables pruning); a
# malformed value refuses to boot. The row carries an ip and a session id,
# so this is the retention window for personal data, not just storage.
#
# `make seed-activity` backdates its rows up to ninety days: the default
# below prunes two thirds of them on the next `orders:sweep`. Raise it for
# local dev, ANALYTICS_RETENTION_DAYS=120 keeps the whole ramp visible.
ANALYTICS_RETENTION_DAYS=30
